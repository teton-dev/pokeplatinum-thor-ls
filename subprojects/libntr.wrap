[wrap-git]
# Thor/Android fork: GLES renderer, android target, second-screen output.
# Pinned to a commit of its thor-android branch; bump it in a commit of its own ("libntr: bump to <sha>").
url = https://github.com/teton-dev/libntr.git
revision = 578c6a8c6e8904aac233d34b8d084e0639f478f1
depth = 1
directory = libntr
# teton-dev fork, Gen 5 battles: G3_MultMtx33/44, G3_MultTransMtx33 and G3_Shininess through the simulator (BW2's
# models call them; Platinum doesn't, and the register writes overran into GXSTAT). For libntr itself, later
# libntr_g3_clip.patch: polygons clipped in clip space before the divide by W, as on the DS (BW2's sky and ground
# meshes reach behind the camera; they were dropped). libntr_g3_clear.patch: the 3D buffer is cleared for a new frame
# only by a command that draws, and in the 3D buffer (Platinum's PC boxes showed a black screen: their vblank handler's
# matrix commands cleared the finished frame)
diff_files = libntr_g3_mult.patch, libntr_g3_clip.patch, libntr_g3_clear.patch

[provide]
dependency_names = NitroSDK
program_names = makelcf

