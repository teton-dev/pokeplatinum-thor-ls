[wrap-git]
# Thor/Android fork: GLES renderer, android target, second-screen output.
# Pinned to a commit of its thor-android branch; bump it in a commit of its own ("libntr: bump to <sha>").
url = https://github.com/teton-dev/libntr.git
revision = 578c6a8c6e8904aac233d34b8d084e0639f478f1
depth = 1
directory = libntr
# teton-dev fork, Gen 5 battles: G3_MultMtx33/44, G3_MultTransMtx33 and G3_Shininess through the simulator (BW2's
# models call them; Platinum doesn't, and the register writes overran into GXSTAT). Translucent polygons (deferred to
# the frame's end) drawn with their own culling and depth test, not the frame's last ones (BW2's battle particles were
# culled). Polygons clipped against the near and far planes before the divide by W (BW2's sky and ground reach behind
# the camera and were dropped, leaving black patches). For libntr itself, later
diff_files = libntr_g3_mult.patch, libntr_g3_translucent_state.patch, libntr_g3_clip.patch

[provide]
dependency_names = NitroSDK
program_names = makelcf

