[wrap-git]
# Thor/Android fork: GLES renderer, android target, second-screen output.
# Pinned to a commit of its thor-android branch; bump it in a commit of its own ("libntr: bump to <sha>").
url = https://github.com/teton-dev/libntr.git
revision = 5068cdaacc7b5dfb6ab53030fae2f4b0b1a82e94
depth = 1
directory = libntr
# teton-dev fork, Gen 5 battles: G3_MultMtx33/44, G3_MultTransMtx33 and G3_Shininess through the simulator (BW2's
# models call them; Platinum doesn't, and the register writes overran into GXSTAT). For libntr itself, later
# libntr_g3_clip.patch: polygons clipped in clip space before the divide by W, as on the DS (BW2's sky and ground
# meshes reach behind the camera; they were dropped). libntr_g3_clear.patch: the 3D buffer is cleared for a new frame
# only by a command that draws, and in the 3D buffer (Platinum's PC boxes showed a black screen: their vblank handler's
# matrix commands cleared the finished frame). libntr_wide_obj.patch: widescreen OBJ layers repeated across the sides
# (SIM_SetWidescreenObjWrap: the overworld's weather sprites fill a wide screen). libntr_snd_waveout.patch: the
# simulated ARM7 carries out the direct channel commands and keeps the channels' status, so that NitroSystem's wave
# output plays (BW2's cries use it). libntr_g3_translucent_state.patch: each deferred translucent polygon is drawn with its own
# culling and depth test (BW2's battle particles were culled). libntr_wide_edge.patch: SIM_SetWidescreenBgEdgeExtend,
# a BG layer's edge columns continued across the sides of a wide scene (BW2's text box reaches the screen's edges).
# libntr_wide_obj_edge.patch: SIM_SetWidescreenObjEdgeExtend, the pixels of OBJs at the 4:3 picture's edge continued
# across the sides of a wide scene (BW2's party balls' bar and ability bar reach the screen's edges).
# libntr_translucent_id.patch: SIM_SetTranslucentPolygonIdRule, the DS's rule that a translucent polygon doesn't blend
# over a pixel another one with its polygon ID drew (BW2's shadows were darker where their parts overlap).
# libntr_wide_window.patch: on a wide BG layer a hardware window that starts at 0 or reaches 255 continues across the
# sides (the HM cut-in's band spans the whole wide screen). libntr_bg_charbase.patch: GX_LoadBG0/1/2Char loaded at
# the character base masked to 128 KB, where the renderer reads the real one (the Journal's text on BG1, char base
# 0x20000, was written over the page's tiles at 0: black pages)
# libntr_wide_mirror.patch: SIM_SetWidescreenBgMirror, a wide BG layer's sides mirror the 256-pixel picture (the HM
# cut-in's rings) instead of repeating it
# libntr_sprite_depth.patch: SIM_SetSpriteDepthBias, polygons moved toward the camera for the depth test only, more
# toward their tops (billboard.c's overworld sprites: a head clears the lower edge of a sign just behind it)
# libntr_snd_lock.patch: the sound commands (the PXI thread) hold SDL's audio lock, so the sequences (the audio
# callback) never read a sequence half set up (a crash in the sequencer's byte cache)
# libntr_wide_subtop_bgs.patch: SIM_SetWidescreenSceneOptions' wide BG layers for the sub engine on top too (BW2's
# Summary: its scrolling grid drawn across the sides from its tilemap, where the edge columns flickered)
# libntr_3d_premultiplied.patch: the 3D layer's alpha accumulates as coverage (premultiplied) and the 2D compositor
# divides it out; translucent particles over an empty pixel were darkened twice (BW2's Hydro Pump edges, stat arrows)
# libntr_native_menus.patch: the settings in the platform's own UI (Android's views, NativeSettings.java): SIM::UI's
# widgets record themselves as JSON instead of drawing, and answer the events that UI sends back; Link play's page
# goes beside the game's connections (order 68)
# libntr_carts_known.patch: "Add a game" applies xdelta 1.1 patches too (Sacred Gold, Storm Silver), warns about ROMs
# and patches the game doesn't know (SIM_Prj_KnownRom, SIM_Prj_KnownPatch, SIM_Prj_CartWarning), and takes its words
# about the game's hacks from the game (SIM_Prj_AddGameText)
# libntr_battle_speed.patch: Settings > Controls > Battle speed (1.5x, 2x, 3x, 4x): while the game says a battle is running
# (SIM_SetBattleActive) it runs at that speed, in place of fast-forward's
# libntr_color_adjust.patch: Settings > Display > Color Balance (sliders: saturation, vibrance, contrast, white point, -25..+25,
# applied to each screen before the fade; SIM::UI::Slider), and the defaults Widescreen on and Fast forward as a toggle
# libntr_native_menus_carts.patch: the carts UI over the settings: the native view steps aside (SuspendNative)
# libntr_enhanced_grade.patch: Enhanced graphics' first pass: SIM_SetEnhancedScene, the 3D frame tinted by the time of
# day's light and its corners darkened (Settings > Display > Time-of-day light)
# libntr_enhanced_shadows.patch: SIM_SetSpriteShadow / SIM_SetEnhancedSun: the overworld's character sprites (inside the
# depth-bias bracket) also draw a sheared, dark copy of themselves along the ground (Settings > Display > Sun shadows)
# libntr_enhanced_water.patch: SIM_SetPolygonTag / SIM_SetEnhancedWater: the game's water tiles as a mask (drawn against the
# scene's depth), each water pixel's distance to the shore at the DS's resolution, and the scene above the shore
# mirrored in the water from a copy of the frame, in whole DS pixels (Settings > Display > Water reflections)
# libntr_enhanced_shadow_grid.patch: the sun shadow stands on the sprite's feet (its lowest opaque row) and keeps the sprite's
# texel grid (rows squeezed, whole-texel shifts per row, done in the fragment shader) instead of a sheared quad
# libntr_enhanced_sun_shadows_3d.patch: sun shadows of the scene's 3D (trees, signs, houses, cliffs): a march toward the sun through
# the depth buffer at the DS's resolution, a multiply at full resolution; the sprites flagged in the attributes; the game's
# own faint shadow polygons dropped while the land is drawn (SIM_SetEnhancedShadowCamera, SIM_SetHideBuiltInShadows)
# libntr_enhanced_highlights.patch: SIM_SetEnhancedSunLight, Settings > Display > Sun highlights: from the depth buffer's normals (and the
# polygon IDs that mark buildings) walls and roofs glint, lift and sheen in the sun's colour, brightening their own pixels;
# sprites get a rim of the sun's colour on its side (DS resolution, then a full-resolution brighten/add)
# libntr_native_screens.patch: the carts UI (Add a game, the game picker, a version question) as native views too
# libntr_second_swap_after.patch: Android with two screens swaps the second screen's frame right after the main one's
# (it waited up to a refresh first, and the two waits made 30 fps on a 60 Hz panel). libntr_android_pacing.patch: Android's
# swap interval is 0 and the 60 fps limit is a running deadline (PaceVBlank), so no display's refresh rate halves the speed
# libntr_enhanced_atmosphere.patch: SIM_SetEnhancedAtmosphere / SIM_SetEnhancedBloom, Settings > Display > Atmosphere and Glow: haze and sun shafts from a march through the depth buffer, and a blur-based glow of bright pixels.
# libntr_enhanced_shadow_res.patch: the sun shadows' edges at the internal resolution: a sprite's shadow leans in
# sub-texel steps (its shape still the sprite's texels); the 3D shadows' mask stays a DS pixel per texel and its edges are
# blended between the four nearest texels and cut at one half, so DS-pixel stairs become smooth edges of small pixels
# libntr_enhanced_shadow_map.patch: the 3D sun shadows from a real shadow map: the land and buildings opaque polygons
# (and SIM_SetSunCasters models) kept whole as they are submitted, drawn from the sun (orthographic, 2048x2048 depth, clear
# texels left out) and each DS pixel looked up in it; SIM_SUNSHADOW_METHOD=march keeps the older depth-buffer march
# libntr_android_main_async.patch: Android's pacing watchdog. After fast-forward the Duo's main window swap could take a
# refresh every frame (30 fps, the game at half speed) until the settings opened over the lower screen: two frames aren't
# shown when fast-forward ends, and a second under 45 fps with swaps over 10 ms tries remedies in turn (the lower screen's window draws a frame,
# frames skipped, its surface made again; PlatinumActivity.unstickDisplays), logging which cleared it. The main window's
# swap interval is set to 0 again on a new surface; the frame timings show the second screen's swap apart.
# libntr_enhanced_jubilife.patch: the enhanced passes timed on the GPU one by one (Settings > Advanced > Frame timings);
# a 1024x1024 shadow map, the shadows' clean-up left out with it and the atmosphere's shafts read from it (60 fps in
# Jubilife on the Duo); the shadow map's casters pushed back by their slope (no dotted roofs); the sprites' rim found
# at full resolution on their own pixels (it flickered on running sprites)
# libntr_android_watchdog_status.patch: the frame timings overlay's first line says how often Android's pacing watchdog
# stepped in, its last remedy and the last one that brought the frame rate back (its log lines don't reach logcat).
diff_files = libntr_g3_mult.patch, libntr_g3_clip.patch, libntr_g3_clear.patch, libntr_wide_obj.patch, libntr_snd_waveout.patch, libntr_g3_translucent_state.patch, libntr_wide_edge.patch, libntr_translucent_id.patch, libntr_g3_perspective.patch, libntr_wide_obj_edge.patch, libntr_wide_window.patch, libntr_bg_charbase.patch, libntr_wide_mirror.patch, libntr_wide_subtop.patch, libntr_tex_bank_d.patch, libntr_wide_stripe.patch, libntr_sprite_depth.patch, libntr_snd_lock.patch, libntr_g3_tex_wrap.patch, libntr_wide_subtop_bgs.patch, libntr_3d_premultiplied.patch, libntr_native_menus.patch, libntr_native_menus_carts.patch, libntr_carts_known.patch, libntr_battle_speed.patch, libntr_color_adjust.patch, libntr_native_screens.patch, libntr_second_swap_after.patch, libntr_android_pacing.patch, libntr_enhanced_grade.patch, libntr_enhanced_shadows.patch, libntr_enhanced_water.patch, libntr_enhanced_shadow_grid.patch, libntr_enhanced_sun_shadows_3d.patch, libntr_enhanced_highlights.patch, libntr_enhanced_atmosphere.patch, libntr_enhanced_shadow_res.patch, libntr_enhanced_shadow_map.patch, libntr_android_main_async.patch, libntr_enhanced_jubilife.patch, libntr_android_watchdog_status.patch

[provide]
dependency_names = NitroSDK
program_names = makelcf

