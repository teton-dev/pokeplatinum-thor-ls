+void G2SIM_SetWideStampImage(const unsigned char *rgb, int width, int height) {
+  if (rgb == nullptr || width <= 0 || height <= 0 || width > 16 || height > 64) {
+    sStampW = sStampH = 0;
+    return;
+  }
+  memcpy(sStampImage, rgb, (size_t)width * height * 3);
+  sStampW = width;
