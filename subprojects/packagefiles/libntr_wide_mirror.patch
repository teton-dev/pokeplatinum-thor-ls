+
+void G2SIM_SetWideStamps(unsigned char bgNum, const SIM_WideStamp *stamps, int count) {
+  sStampBg = bgNum;
+  sStampCount = count > kMaxWideStamps ? kMaxWideStamps : (count < 0 ? 0 : count);
+  for (int i = 0; i < sStampCount; i++) {
+    sStamps[i] = stamps[i];
+  }
