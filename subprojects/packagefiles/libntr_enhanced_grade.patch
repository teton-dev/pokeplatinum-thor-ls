--- /dev/null
+++ b/libraries/sim/src/shaders/g3_enhanced_fragment.glsl
@@ -0,0 +1,20 @@
+R""(
+#version 420 core
+
+// Enhanced graphics' grade (SIM_SetEnhancedScene): the finished 3D frame is multiplied by the
+// scene's tint (the time of day's light) and darkened toward the corners by the vignette. It is
+// the blend that multiplies (colour * destination), so the shader reads nothing: one output per
+// pixel and no copy of the frame. The 3D layer is premultiplied, so scaling its colour is right
+// as it is; alpha is left alone (the blend keeps the destination's).
+uniform vec3 tint;
+uniform float vignette; // 0 to 1: how dark the corners get
+uniform vec4 viewportRect; // x0, y0, x1, y1 in framebuffer pixels
+out vec4 color;
+
+void main()
+{
+    vec2 uv = (gl_FragCoord.xy - viewportRect.xy) / (viewportRect.zw - viewportRect.xy) - 0.5;
+    float edge = dot(uv, uv) * 2.0; // 0 in the middle, 1 in the corners
+    color = vec4(tint * (1.0 - vignette * edge * edge), 1.0);
+}
+)""
