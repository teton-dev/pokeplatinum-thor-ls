+// The grade: the finished 3D frame multiplied by the scene's tint, corners darkened (g3_enhanced_fragment.glsl). One
+// pass of a single triangle that reads nothing, so it costs a blend per pixel. Once per frame drawn (a frame shown at
+// two vblanks isn't graded twice), after the edge marking, over the 3D viewport (the wide one too).
+static void G3EnhancedGrade() {
+  static u32 sLastDrawSerial = 0;
+  const u32 drawSerial = G3SIM_DrawSerial();
+  const bool drawn = drawSerial != sLastDrawSerial;
+  sLastDrawSerial = drawSerial;
+  const bool neutral = sEnhancedTint[0] == 255 && sEnhancedTint[1] == 255 && sEnhancedTint[2] == 255 &&
+                       sEnhancedVignette == 0;
+  if (!drawn || neutral || !s_SIM_config.enhancedGrading || sG3Viewport[2] <= 0 || sG3Viewport[3] <= 0) {
+    return;
+  }
+  static GLint sLocTint = -2, sLocVignette, sLocRect;
+  if (sLocTint == -2) {
+    sLocTint = glGetUniformLocation(g3EnhancedProgramID, "tint");
+    sLocVignette = glGetUniformLocation(g3EnhancedProgramID, "vignette");
+    sLocRect = glGetUniformLocation(g3EnhancedProgramID, "viewportRect");
+  }
+  glProgramUniform3f(g3EnhancedProgramID, sLocTint, sEnhancedTint[0] / 255.0f, sEnhancedTint[1] / 255.0f,
+                     sEnhancedTint[2] / 255.0f);
+  glProgramUniform1f(g3EnhancedProgramID, sLocVignette, sEnhancedVignette / 255.0f);
+  glProgramUniform4f(g3EnhancedProgramID, sLocRect, (float)sG3Viewport[0], (float)sG3Viewport[1],
+                     (float)(sG3Viewport[0] + sG3Viewport[2]), (float)(sG3Viewport[1] + sG3Viewport[3]));
+
+  GLint viewport[4];
+  GLint vertexArray;
+  glGetIntegerv(GL_VIEWPORT, viewport);
+  glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vertexArray);
+  const GLboolean depthTest = glIsEnabled(GL_DEPTH_TEST);
+  const GLboolean cullFace = glIsEnabled(GL_CULL_FACE);
+
+  // The colour output alone: the second one holds the polygon IDs and depth, which this pass must not touch
+  static const GLenum kBoth[2] = {GL_COLOR_ATTACHMENT0, GL_COLOR_ATTACHMENT1};
+  glBindFramebuffer(GL_FRAMEBUFFER, g3FrameBuffer);
+  glDrawBuffers(1, kBoth);
+  glViewport(sG3Viewport[0], sG3Viewport[1], sG3Viewport[2], sG3Viewport[3]);
+  glDisable(GL_DEPTH_TEST);
+  glDisable(GL_CULL_FACE);
+  // colour times what is there; alpha stays
+  glBlendFuncSeparate(GL_DST_COLOR, GL_ZERO, GL_ZERO, GL_ONE);
+  glUseProgram(g3EnhancedProgramID);
+  glBindVertexArray(g3EdgeVertexArray);
+  glDrawArrays(GL_TRIANGLES, 0, 3);
+
+  glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+  glBindVertexArray(vertexArray);
+  glUseProgram(g3shaderProgramID);
+  if (cullFace) {
+    glEnable(GL_CULL_FACE);
+  }
+  if (depthTest) {
+    glEnable(GL_DEPTH_TEST);
+  }
+  glDrawBuffers(sSamples == 0 ? 2 : 1, kBoth);
+  glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+}
