+// The part of a picture's texture to draw (all of it, but for Gen 5's sprites)
+const Picture *PictureOf(PictureKind kind, u16 species, u8 form, bool egg, bool shiny, u8 gender, u32 personality) {
+  PictureTexture(kind, species, form, egg, shiny, gender, personality);
+  const u32 spots = (kind == PICTURE_FRONT || kind == PICTURE_FRONT_GRAY) && species == 327 ? personality : 0;
+  const u64 key = ((u64)kind << 60) | ((u64)(egg ? 1 : 0) << 59) | ((u64)(shiny ? 1 : 0) << 58) | ((u64)(gender & 3) << 56)
+                  | ((u64)form << 48) | ((u64)species << 32) | spots;
+  auto found = sPictures.find(key);
+  return found != sPictures.end() ? &found->second : nullptr;
+}
