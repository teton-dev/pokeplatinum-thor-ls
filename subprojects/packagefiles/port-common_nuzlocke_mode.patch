+// A Pokemon's picture for the Nuzlocke status: its Gen 5 sprite when Gen 5 battles are on and the ROM is imported
+// (else the game's own), in colour when caught and grayed out when missed
+void DrawCatchSprite(ImDrawList *draw, ImVec2 pos, float size, u16 species, bool gray) {
+  if (PortGame_GearGen5Sprites()) {
+    const Picture *picture = PictureOf(gray ? PICTURE_GEN5_GRAY : PICTURE_GEN5, species, 0, false, false, 0, 0);
+    if (picture != nullptr && picture->texture != 0) {
+      pos = ImVec2(std::floor(pos.x), std::floor(pos.y));
+      draw->AddImage(ImTextureRef((ImTextureID)(intptr_t)picture->texture), pos, ImVec2(pos.x + size, pos.y + size),
+                     ImVec2(picture->u0, picture->v0), ImVec2(picture->u1, picture->v1));
+      return;
+    }
+  }
+  const unsigned int texture = PictureTexture(gray ? PICTURE_FRONT_GRAY : PICTURE_FRONT, species, 0, false, false, 0, 0);
+  if (texture != 0) {
+    pos = ImVec2(std::floor(pos.x), std::floor(pos.y));
+    draw->AddImage(ImTextureRef((ImTextureID)(intptr_t)texture), pos, ImVec2(pos.x + size, pos.y + size));
+  }
+}
