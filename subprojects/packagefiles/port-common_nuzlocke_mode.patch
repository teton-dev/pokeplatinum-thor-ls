+// An area's status: its picture (caught: in colour; missed: grayed out) beside the headline and what it means
+void DrawCatchStatus(u16 location, float pictureSize, const char *areaName) {
+  u16 species = 0;
+  const int status = Nuzlocke_AreaStatus(location, &species);
+  if (status == NUZLOCKE_CATCH_NONE) {
+    return;
+  }
+  char buffer[48];
+  const CatchLook look = CatchLookOf(status, species != 0 ? Gear_SpeciesName(species) : "", buffer, sizeof(buffer));
+  const bool hasPicture = species != 0 && status != NUZLOCKE_CATCH_AVAILABLE;
+  const float size = hasPicture ? S(pictureSize) : 0.0f;
+  ImVec2 pos = ImGui::GetCursorScreenPos();
+  if (areaName != nullptr) {
+    TextAt(ImGui::GetWindowDrawList(), sBold, S(17.0f), pos, kText, areaName);
+    pos.y += S(24.0f);
+  }
+  ImDrawList *draw = ImGui::GetWindowDrawList();
+  if (hasPicture) {
+    DrawCatchSprite(draw, pos, size, species, status != NUZLOCKE_CATCH_CAUGHT);
+  }
+  const float textX = pos.x + (hasPicture ? size + S(8.0f) : 0.0f);
+  const float lineY = pos.y + (hasPicture ? size * 0.16f : 0.0f);
+  TextAt(draw, sBold, S(18.0f), ImVec2(textX, lineY), look.color, look.headline);
+  char detail[96];
+  if (status == NUZLOCKE_CATCH_CAUGHT || status == NUZLOCKE_CATCH_FAILED) {
+    snprintf(detail, sizeof(detail), status == NUZLOCKE_CATCH_CAUGHT ? "%s, caught here." : "%s got away.",
+             Gear_SpeciesName(species));
+  } else {
+    snprintf(detail, sizeof(detail), "%s", look.detail);
+  }
+  TextAt(draw, sRegular, S(14.0f), ImVec2(textX, lineY + S(24.0f)), kTextDim, detail);
+  ImGui::Dummy(ImVec2(0, (hasPicture ? size : S(46.0f)) + (areaName != nullptr ? S(24.0f) : 0.0f)));
+}
