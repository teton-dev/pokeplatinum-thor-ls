+// What an area's catch status says, and in what colour: green "Catch available", yellow "Limited to X", red
+// "Catch failed" (Hard) and blue "Catch complete"
+struct CatchLook {
+  const char *headline;
+  ImU32 color;
+  const char *detail;
+};
+
+CatchLook CatchLookOf(int status, const char *species, char *buffer, size_t size) {
+  switch (status) {
+  case NUZLOCKE_CATCH_AVAILABLE:
+    return { "Catch available", kGood, "The first wild Pokemon you meet here counts." };
+  case NUZLOCKE_CATCH_LIMITED:
+    snprintf(buffer, size, "Limited to %s", species);
+    return { buffer, kWarn, "It got away: only that species may be caught here." };
+  case NUZLOCKE_CATCH_FAILED:
+    return { "Catch failed", kBad, "The first one got away: nothing more to catch here." };
+  case NUZLOCKE_CATCH_CAUGHT:
+    return { "Catch complete", kCaught, "Caught here." };
+  default:
+    return { "", kTextDim, "" };
+  }
+}
