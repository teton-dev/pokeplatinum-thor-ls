+void main()
+{
+    ivec2 fragment = ivec2(gl_FragCoord.xy);
+    vec4 attr = texelFetch(attrTexture, fragment, 0);
+    ivec4 a = ivec4(attr * 255.0 + 0.5);
+    float ndcz = float(a.g * 256 + a.b) / 65535.0 * 2.0 - 1.0;
+    float d = projection.w / (ndcz + projection.z);
+    vec2 ndc = (vec2(fragment - origin) + 0.5) / vec2(viewportSize) * 2.0 - 1.0;
+    vec3 p = vec3(ndc.x / xScale * d / projection.x, ndc.y * d / projection.y, -d);
+    // The derivatives are taken before any early exit (they need the whole 2x2 quad)
+    vec3 n = cross(dFdx(p), dFdy(p));
+    if (a.a == 0 || d <= 0.0) {
+        discard;
+    }
+    vec3 toLamp = lamp.xyz - p;
+    float distance2 = dot(toLamp, toLamp);
+    float r2 = lamp.w * lamp.w;
+    if (distance2 >= r2) {
+        discard;
+    }
+    float k = 1.0 - distance2 / r2;
+    float falloff = k * k;
+    vec3 l = toLamp * inversesqrt(max(distance2, 1e-4));
+    float facing;
+    if ((a.r & 1) == 1) {
+        facing = 0.7; // a sprite: a picture facing the camera
+    } else {
+        float nn = dot(n, n);
+        vec3 normal = nn > 1e-10 ? n * inversesqrt(nn) : -normalize(p);
+        if (dot(normal, -p) < 0.0) {
+            normal = -normal;
+        }
+        // Softened (an edge's derivatives mix two surfaces): a little light reaches faces turned away too
+        facing = 0.25 + 0.75 * max(dot(normal, l), 0.0);
+    }
+    color = vec4(lampColor * (falloff * facing), 0.0);
+}
