+// from the screen-space derivatives of that place (free in a fragment shader); the sprites (flagged in the attributes) face
+// the camera and take a share of the light whichever way it comes. The output brightens the pixel's own colour (the blend
+// is dst * (1 + light)), so the art's detail and outlines stay as drawn; nothing is filtered or moved.
+uniform sampler2D attrTexture; // polygon ID * 4 + 1 for a sprite in r, the depth's high and low bytes in g and b, a set where drawn
+uniform ivec2 origin;
+uniform ivec2 viewportSize;
+uniform vec4 projection;       // the game's projection: m00, m11, m22, m32
+uniform float xScale;          // a wide scene libntr narrows
+uniform vec4 lamp;             // the lamp's centre in view space, and its radius
+uniform vec3 lampColor;        // its colour times its strength
+out vec4 color;
