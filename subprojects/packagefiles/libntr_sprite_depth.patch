+            double y = (double)clip[i].pos[1] / (double)clip[i].pos[3];
+            lo = y < lo ? y : lo;
+            hi = y > hi ? y : hi;
         }
+        biasBottom = lo;
+        biasSpan = hi - lo;
     }
 
