@@ -0,0 +1,34 @@
+R""(
+#version 420 core
+
+// Enhanced graphics' sun shadow map: depth only, but a textured caster leaves out its clear texels (a tree's crown is a
+// box with a round picture on it: its shadow is the picture's shape). The texel is picked as the DS does (no filtering),
+// the coordinates wrapped as the polygon's texture says
+uniform sampler2D casterTexture;
+uniform int useTexture;
+uniform int wrap; // bits: repeat s, flip s, repeat t, flip t
+in vec2 uv;
+
+float Wrap(float c, bool repeatIt, bool flip)
+{
+    if (!repeatIt) {
+        return clamp(c, 0.0, 0.999999);
+    }
+    if (flip) {
+        float m = mod(c, 2.0);
+        return m < 1.0 ? m : 2.0 - m - 0.000001;
+    }
+    return fract(c);
+}
+
+void main()
+{
+    if (useTexture == 1) {
+        vec2 c = vec2(Wrap(uv.x, (wrap & 1) != 0, (wrap & 2) != 0), Wrap(uv.y, (wrap & 4) != 0, (wrap & 8) != 0));
+        ivec2 size = textureSize(casterTexture, 0);
+        if (texelFetch(casterTexture, min(ivec2(c * vec2(size)), size - 1), 0).a < 0.5) {
+            discard;
+        }
+    }
+}
+)""
