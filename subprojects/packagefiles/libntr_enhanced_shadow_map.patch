+  bounds[1] = lo[1];
+  bounds[2] = hi[0] - lo[0];
+  bounds[3] = hi[1] - lo[1];
+  depth[0] = hi[2];           // nearest the sun
+  depth[1] = hi[2] - lo[2];
+  for (u32 v = 0; v < count; v++) {
