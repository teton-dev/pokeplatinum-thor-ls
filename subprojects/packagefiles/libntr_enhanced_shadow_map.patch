+extern "C" void G3SIM_CasterBatchEnd(u32 textureId, u8 wrap)
+{
+    if(s_casterCount == s_casterBatchStart) {
+        return;
+    }
+    if(s_casterBatchCount < G3SIM_CASTER_MAX_BATCHES) {
+        G3SIM_CasterBatch_t * batch = &s_casterBatches[s_casterBatchCount++];
+        batch->start = s_casterBatchStart;
+        batch->count = s_casterCount - s_casterBatchStart;
+        batch->textureId = textureId;
+        batch->wrap = wrap;
+    } else {
+        s_casterOverflow = true;
+    }
+    s_casterBatchStart = s_casterCount;
