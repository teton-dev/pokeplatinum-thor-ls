@@ -0,0 +1,58 @@
+R""(
+#version 420 core
+
+// Enhanced graphics' sun shadows of the scene's 3D, first pass, one fragment per DS pixel: the pixel's place in the scene,
+// rebuilt from the depth the 3D shader left in the attribute texture, is looked up in the shadow map drawn from the sun
+// (the land and buildings' opaque polygons, whole); it is in shadow when something lies nearer the sun along its ray. A
+// real projection of the casters, so a post's shadow is as wide as the post. The sprites are in the depth buffer too but
+// don't receive (they have shadows of their own, from their pictures). Writes what the march wrote (r shadow, g the
+// distance's bands for SIM_SUNSHADOW_DEBUG=2, b set where nothing is shaded), for the clean-up and apply passes.
+uniform sampler2D attrTexture; // polygon ID * 4 + 1 for a sprite in r, the depth's high and low bytes in g and b, a set where opaque
+uniform sampler2D shadowMap;   // depth along the sun's rays, 0 nearest the sun
+uniform ivec2 origin;          // the 3D viewport's corner in the framebuffer
+uniform int pixelStep;         // framebuffer pixels per DS pixel
+uniform ivec2 dsSize;
+uniform vec4 projection;       // the game's projection: m00, m11, m22, m32
+uniform float xScale;          // a wide scene libntr narrows
+uniform vec3 lightRight;       // the sun's view: its axes in view space (toward the sun last)
+uniform vec3 lightUp;
+uniform vec3 toSun;
+uniform vec4 lightBounds;      // across the map: x and y of its corner, and its width and height (view units)
+uniform vec2 lightDepth;       // along the rays: the nearest (toward the sun) and the span
+uniform float bias;            // how much nearer the sun a caster must be (view units)
+uniform int debugMode;
+out vec4 color;
+
+float Distance(ivec2 ds)
+{
+    ivec4 a = ivec4(texelFetch(attrTexture, origin + ds * pixelStep + ivec2(pixelStep / 2), 0) * 255.0 + 0.5);
+    if (a.a == 0 || (a.r & 1) == 1) {
+        return 0.0;
+    }
+    float ndcz = float(a.g * 256 + a.b) / 65535.0 * 2.0 - 1.0;
+    return projection.w / (ndcz + projection.z);
+}
+
+void main()
+{
+    ivec2 ds = ivec2(gl_FragCoord.xy);
+    float distanceHere = Distance(ds);
+    float shadow = 0.0;
+    float probe = 0.0; // SIM_SUNSHADOW_DEBUG=4: the map's depth here; 5: the pixel's own (they match on lit ground)
+    if (distanceHere > 0.0) {
+        vec2 ndc = ((vec2(ds) + 0.5) / vec2(dsSize)) * 2.0 - 1.0;
+        vec3 here = vec3(ndc.x / xScale * distanceHere / projection.x, ndc.y * distanceHere / projection.y, -distanceHere);
+        vec2 across = (vec2(dot(here, lightRight), dot(here, lightUp)) - lightBounds.xy) / lightBounds.zw;
+        float along = (lightDepth.x - dot(here, toSun)) / lightDepth.y;
+        if (all(greaterThanEqual(across, vec2(0.0))) && all(lessThan(across, vec2(1.0)))) {
+            ivec2 size = textureSize(shadowMap, 0);
+            float nearest = texelFetch(shadowMap, ivec2(across * vec2(size)), 0).r;
+            probe = debugMode == 4 ? nearest : along;
+            if (along - nearest > bias / lightDepth.y) {
+                shadow = 1.0;
+            }
+        }
+    }
+    color = vec4(shadow, debugMode >= 4 ? fract(probe * 8.0) : fract(distanceHere / 16.0), distanceHere > 0.0 ? 0.0 : 1.0, 1.0);
+}
+)""
