+    q[0] = (q[0] - bounds[0]) / bounds[2] * 2.0f - 1.0f;
+    q[1] = (q[1] - bounds[1]) / bounds[3] * 2.0f - 1.0f;
+    q[2] = (depth[0] - q[2]) / depth[1] * 2.0f - 1.0f;
+  }
