+// The sun shadow map, drawn from this frame's casters (see G3SIM_TakeCasters): each vertex back in view space (the game's
+// projection undone: x = x_clip / m00, y = y_clip / m11, z = -w), then in the sun's view, an orthographic one along toSun
+// fitted to the casters. Fills the uniforms the receive pass needs; false when there is nothing to draw
+static bool G3SunShadowMap(const float *casters, u32 count, const G3SIM_CasterBatch_t *batches, u32 batchCount,
+                           float right[3], float up[3], float bounds[4], float depth[2]) {
+  if (count < 3) {
+    return false;
+  }
+  const float m00 = sSunCamera[0], m11 = sSunCamera[1];
+  const float L[3] = {sSunCamera[4], sSunCamera[5], sSunCamera[6]};
+  if (m00 == 0.0f || m11 == 0.0f) {
+    return false;
+  }
+  // The sun's axes: right = helper x L, up = L x right
+  const float helper[3] = {fabsf(L[1]) < 0.9f ? 0.0f : 1.0f, fabsf(L[1]) < 0.9f ? 1.0f : 0.0f, 0.0f};
+  right[0] = helper[1] * L[2] - helper[2] * L[1];
+  right[1] = helper[2] * L[0] - helper[0] * L[2];
+  right[2] = helper[0] * L[1] - helper[1] * L[0];
+  const float rl = sqrtf(right[0] * right[0] + right[1] * right[1] + right[2] * right[2]);
+  for (int i = 0; i < 3; i++) {
+    right[i] /= rl;
+  }
+  up[0] = L[1] * right[2] - L[2] * right[1];
+  up[1] = L[2] * right[0] - L[0] * right[2];
+  up[2] = L[0] * right[1] - L[1] * right[0];
+
+  static std::vector<float> sPlaced;
+  sPlaced.resize((size_t)count * 5);
