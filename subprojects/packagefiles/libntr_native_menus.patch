+#ifdef SDK_BUILD_ANDROID
+// Calls a method of the SDL activity (PlatinumActivity); FALSE when it has none (an older Java side)
+bool CallActivity(const char *name, const char *signature, jvalue *args, jboolean *result) {
+  JNIEnv *env = (JNIEnv *)SDL_AndroidGetJNIEnv();
+  jobject activity = (jobject)SDL_AndroidGetActivity();
+  if (env == nullptr || activity == nullptr) {
+    return false;
+  }
+  jclass cls = env->GetObjectClass(activity);
+  jmethodID method = env->GetMethodID(cls, name, signature);
+  bool ok = method != nullptr;
+  if (!ok) {
+    env->ExceptionClear();
+  } else if (result != nullptr) {
+    *result = env->CallBooleanMethodA(activity, method, args);
+  } else {
+    env->CallVoidMethodA(activity, method, args);
+  }
+  if (env->ExceptionCheck()) {
+    env->ExceptionClear();
+    ok = false;
+  }
+  env->DeleteLocalRef(cls);
+  env->DeleteLocalRef(activity);
+  return ok;
+}
+#endif
+
+bool NativeWanted() {
+#ifdef SDK_BUILD_ANDROID
+  jboolean on = JNI_FALSE;
+  return CallActivity("nativeSettingsEnabled", "()Z", nullptr, &on) && on;
+#else
+  const char *env = getenv("SIM_NATIVE_SETTINGS");
+  return env != nullptr && env[0] == '1';
+#endif
+}
+
+void NativeSend(const std::string &json) {
+#ifdef SDK_BUILD_ANDROID
+  JNIEnv *env = (JNIEnv *)SDL_AndroidGetJNIEnv();
+  if (env == nullptr) {
+    return;
+  }
+  jvalue arg;
+  arg.l = env->NewStringUTF(json.c_str());
+  CallActivity("nativeSettingsState", "(Ljava/lang/String;)V", &arg, nullptr);
+  env->DeleteLocalRef(arg.l);
+#else
+  printf("[native-settings] %s\n", json.c_str());
+#endif
+}
+
+void NativeHide() {
+#ifdef SDK_BUILD_ANDROID
+  CallActivity("nativeSettingsClosed", "()V", nullptr, nullptr);
+#else
+  printf("[native-settings] closed\n");
+#endif
+}
+
+void PushNativeEvent(const char *text) {
+  std::lock_guard<std::mutex> lock(sNativeLock);
+  if (sNativeEvents.size() < 64) {
+    sNativeEvents.push_back(text);
+  }
+}
+
+// "kind id value" or "kind @label value" (the label may have spaces; the value is the last word)
+bool ParseNativeEvent(const std::string &text, SIM::UI::NativeEvent *out) {
+  const size_t space = text.find(' ');
+  if (space == std::string::npos) {
+    return false;
+  }
+  out->kind = text.substr(0, space);
+  std::string rest = text.substr(space + 1);
+  const size_t last = rest.rfind(' ');
+  std::string target = last == std::string::npos ? rest : rest.substr(0, last);
+  out->value = last == std::string::npos ? 0 : atoi(rest.c_str() + last + 1);
+  if (!target.empty() && target[0] == '@') {
+    out->label = target.substr(1);
+    if (last != std::string::npos && (out->kind == "tap")) {
+      out->label = rest.substr(1); // a tap has no value: all of it is the label
+    }
+  } else {
+    out->id = (unsigned)strtoul(target.c_str(), nullptr, 10);
+  }
+  return true;
+}
