+// --- Native menus ---------------------------------------------------------------------------
+// While a pass is recorded (BeginNativeRecording), the widgets draw nothing: each one adds itself to a JSON array
+// (what the platform's own UI shows, sim_settings.cpp) and answers the pass's event when it is the widget's.
+
+namespace {
+
+struct Recorder {
+  bool active = false;
+  std::string items;
+  bool firstItem = true;
+  bool inTiles = false;
+  bool firstTile = true;
+  NativeEvent event;
+  bool hasEvent = false;
+  bool eventUsed = false;
+  bool back = false;
+  bool backUsed = false;
+  unsigned lastId = 0;
+  unsigned focusId = 0;
+  bool focusRequest = false;
+  bool focusNext = false;
+  std::unordered_map<unsigned, int> seen;
+};
+Recorder sRec;
+
+std::string Shown(const char *label) {
+  return label != nullptr ? std::string(label, TextEnd(label)) : std::string();
+}
+
+void Json(std::string &out, const char *text) {
+  out += '"';
+  for (const char *c = text != nullptr ? text : ""; *c != '\0'; c++) {
+    const unsigned char ch = (unsigned char)*c;
+    if (ch == '"' || ch == '\\') {
+      out += '\\';
+      out += (char)ch;
+    } else if (ch == '\n') {
+      out += "\\n";
+    } else if (ch < 0x20) {
+      char esc[8];
+      snprintf(esc, sizeof(esc), "\\u%04x", ch);
+      out += esc;
+    } else {
+      out += (char)ch;
+    }
+  }
+  out += '"';
+}
+
+// A widget's ID: Dear ImGui's for its label in the current ID stack, made unique within the pass
+unsigned RecId(const char *label, const char *kind) {
+  ImGui::PushID(kind);
+  unsigned id = ImGui::GetID(label != nullptr ? label : "");
+  ImGui::PopID();
+  int &count = sRec.seen[id];
+  if (count++ > 0) {
+    id = ImHashData(&count, sizeof(count), id);
+  }
+  return id & 0x7FFFFFFF; // a positive JSON number for any platform
+}
+
+// The pass's event, when it is for this widget (by ID, or by its shown label for "@label" events)
+bool RecEvent(const char *kind, unsigned id, const char *label) {
+  if (!sRec.hasEvent || sRec.eventUsed || sRec.event.kind != kind) {
+    return false;
+  }
+  const bool match = sRec.event.label.empty() ? sRec.event.id == id : sRec.event.label == Shown(label);
+  if (match) {
+    sRec.eventUsed = true;
+  }
+  return match;
+}
+
+std::string &RecBegin(const char *type, unsigned id) {
+  std::string &out = sRec.items;
+  if (sRec.inTiles) {
+    out += sRec.firstTile ? "" : ",";
+    sRec.firstTile = false;
+  } else {
+    out += sRec.firstItem ? "" : ",";
+    sRec.firstItem = false;
+  }
+  out += "{\"t\":";
+  Json(out, type);
+  if (id != 0) {
+    out += ",\"id\":" + std::to_string(id);
+    sRec.lastId = id;
+    if (sRec.focusNext) {
+      sRec.focusId = id;
+      sRec.focusRequest = true;
+      sRec.focusNext = false;
+    }
+  }
+  return out;
 }
 
+void RecStr(const char *key, const char *value) {
+  if (value == nullptr) {
+    return;
+  }
+  sRec.items += ",\"";
+  sRec.items += key;
+  sRec.items += "\":";
+  Json(sRec.items, value);
+}
+
+void RecStr(const char *key, const std::string &value) {
+  RecStr(key, value.c_str());
+}
+
+void RecInt(const char *key, long long value) {
+  sRec.items += ",\"";
+  sRec.items += key;
+  sRec.items += "\":" + std::to_string(value);
+}
+
+void RecBool(const char *key, bool value) {
+  sRec.items += ",\"";
+  sRec.items += key;
+  sRec.items += value ? "\":true" : "\":false";
+}
+
+void RecEnd() {
+  sRec.items += "}";
+}
+
 } // namespace
+
+void BeginNativeRecording(const NativeEvent *event, bool back) {
+  sRec = Recorder();
+  sRec.active = true;
+  if (event != nullptr) {
+    sRec.event = *event;
+    sRec.hasEvent = true;
+  }
+  sRec.back = back;
+}
+
+std::string EndNativeRecording(bool *eventUsed, bool *backUsed, unsigned *focusId, bool *focusRequest) {
+  if (sRec.inTiles) {
+    sRec.items += "]}";
+    sRec.inTiles = false;
+  }
+  sRec.active = false;
+  *eventUsed = sRec.eventUsed;
+  *backUsed = sRec.backUsed;
+  *focusId = sRec.focusId;
+  *focusRequest = sRec.focusRequest;
+  return "[" + sRec.items + "]";
+}
 
+bool NativeRecording() {
+  return sRec.active;
+}
