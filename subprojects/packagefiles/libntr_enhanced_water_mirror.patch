+R""(
+#version 420 core
+
+// Enhanced graphics' water, the mirror image: textured as the game draws it (the texel picked as the DS does, the
+// coordinates wrapped as the polygon's texture says, clear texels left out) and coloured by its vertices. Only what
+// stands up: nothing at or below the bank's height (the water, the pond's own walls) and no ground (a surface facing up):
+// a true mirror of a sunken pond shows its far bank as a second, lower plane of grass that hides the fences and trees
+// behind it; left out, the things standing by the water show in it, which is what the eye expects of this view
+uniform sampler2D mirrorTexture;
+uniform int useTexture;
+uniform int wrap; // bits: repeat s, flip s, repeat t, flip t
+in vec2 uv;
+in vec4 tint;
+in float above;
+in vec3 viewPosition;
+uniform vec3 upView;
+out vec4 color;
+
+float Wrap(float c, bool repeatIt, bool flip)
+{
+    if (!repeatIt) {
+        return clamp(c, 0.0, 0.999999);
+    }
+    if (flip) {
+        float m = mod(c, 2.0);
+        return m < 1.0 ? m : 2.0 - m - 0.000001;
+    }
+    return fract(c);
+}
+
+void main()
+{
+    if (above < 4.0) {
+        discard; // the water, the pond's walls, its rim and kerbs (a quarter of a tile)
+    }
+    vec3 n = cross(dFdx(viewPosition), dFdy(viewPosition));
+    if (abs(dot(normalize(n), upView)) > 0.8) {
+        discard; // ground, a flat top
+    }
+    vec4 c = vec4(tint.rgb, 1.0);
+    if (useTexture == 1) {
+        vec2 w = vec2(Wrap(uv.x, (wrap & 1) != 0, (wrap & 2) != 0), Wrap(uv.y, (wrap & 4) != 0, (wrap & 8) != 0));
+        ivec2 size = textureSize(mirrorTexture, 0);
+        vec4 texel = texelFetch(mirrorTexture, min(ivec2(w * vec2(size)), size - 1), 0);
+        if (texel.a < 0.5) {
+            discard;
+        }
+        c.rgb *= texel.rgb;
+    }
+    color = c;
+}
+)""
--- a/libraries/sim/src/shaders/g3_water_mirror_vertex.glsl
+++ b/libraries/sim/src/shaders/g3_water_mirror_vertex.glsl
@@ -0,0 +1,34 @@
+R""(
+#version 420 core
+
+// Enhanced graphics' water, the mirror image: the land and buildings' polygons this frame (kept whole as the game sent
+// them, in clip space: x, y and w in view units), back in view space, mirrored about the water's level along the world's
+// up, and projected with the game's own projection, so each lands where its reflection is seen from the camera
+layout (location = 0) in vec3 position; // x and y in clip space, w
+layout (location = 1) in vec2 texCoord;
+layout (location = 2) in vec4 inColor;
+uniform vec4 projection;  // the game's: m00, m11, m22, m32
+uniform vec3 upView;      // the world's up in view space, unit length
+uniform float waterLevel; // the water's height along upView (view units)
+uniform float bankLevel;  // the height of the ground the water lies in (its tiles' height)
+uniform float xScale;     // a wide scene libntr narrows
+out vec2 uv;
+out vec4 tint;
+out float above;          // how far above the bank the point is (what is below it isn't mirrored)
+out vec3 viewPosition;    // unmirrored, for the surface's slope
+
+void main()
+{
+    vec3 p = vec3(position.x / projection.x, position.y / projection.y, -position.z);
+    // Mirrored about the bank, not the water: the things standing by a sunken pond are reflected from where they meet
+    // the ground, not pushed down by twice the pond's drop (which put them, and a second copy of the pond's rim, in the
+    // middle of the water)
+    float height = dot(p, upView) - bankLevel;
+    vec3 m = p - 2.0 * height * upView;
+    above = dot(p, upView) - bankLevel;
+    viewPosition = p;
+    uv = texCoord;
+    tint = inColor;
+    gl_Position = vec4(projection.x * m.x * xScale, projection.y * m.y, projection.z * m.z + projection.w, -m.z);
+}
+)""
