+    float depth = wBuffer == 1 ? clamp(depthW * 0.5 + 0.5, 0.0, 1.0) : gl_FragCoord.z;
+    gl_FragDepth = depth;
+    float depth16 = floor(clamp(depth, 0.0, 1.0) * 65535.0 + 0.5);
     float depthHigh = floor(depth16 / 256.0);
     attr = vec4(polygonId * 4.0 / 255.0, depthHigh / 255.0, (depth16 - depthHigh * 256.0) / 255.0,
