+static NNS_G2D_INLINE BOOL HasEffectiveFrame_ (const NNSG2dAnimSequence * pSequence)
+{
+    u16 i;
+    for ( i = 0; i < pSequence->numFrames; i++ ) {
+        if ( pSequence->pAnmFrameArray[i].frames != 0 ) {
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
