+extern "C" void SIM_Display_KeepMainAsync(void) {
+#ifdef SDK_BUILD_ANDROID
+  static EGLSurface sAsyncSurface = EGL_NO_SURFACE;
+  const EGLSurface current = eglGetCurrentSurface(EGL_DRAW);
+  if (current != EGL_NO_SURFACE && current != sAsyncSurface) {
+    eglSwapInterval(eglGetCurrentDisplay(), 0);
+    sAsyncSurface = current;
+    DISPLAY_LOG("Main surface %p: swap interval 0", (void *)current);
+  }
+#endif
+}
