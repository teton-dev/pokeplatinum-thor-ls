+
+// The pacing watchdog: on the Duo, after fast-forward, the main window's swap could take a whole refresh every frame
+// (30 frames a second, the game at half speed) until the settings were opened over the lower screen. A second of
+// such swaps at the game's speed and the watchdog tries a remedy, then the next one a second and a half later while
+// it lasts: 0 the lower screen's window draws a frame (what the settings do), 1 a few frames aren't shown, 2 the lower
+// screen's surface is made again. Logcat tag pokeplatinum says which cleared it.
+static int sUnstickStep = 0, sUnstickLast = -1, sUnstickWait = 0, sFastSwaps = 0;
+static void PacingWatchdog(bool steady, bool slowSwap) {
+  if (sUnstickWait > 0) {
+    sUnstickWait--;
+  }
+  if (!steady) {
+    sSlowSwaps = 0;
+    sFastSwaps = 0;
+    return;
+  }
+  if (slowSwap) {
+    sFastSwaps = 0;
+    if (++sSlowSwaps >= 60 && sUnstickWait == 0) {
+      sSlowSwaps = 0;
+      printf("pacing watchdog: swaps take a refresh (half rate), remedy %d\n", sUnstickStep);
+      fflush(stdout); // (stdout goes to logcat through a pipe: flushed or it waits)
+      if (sUnstickStep == 1) {
+        sDrainPresents = 6;
+      } else {
+        SIM_Android_UnstickDisplays(sUnstickStep == 0 ? 0 : 1);
+      }
+      sUnstickLast = sUnstickStep;
+      sUnstickStep = (sUnstickStep + 1) % 3;
+      sUnstickWait = 90;
+    }
+  } else {
+    sSlowSwaps = 0;
+    if (sUnstickLast >= 0 && ++sFastSwaps >= 60) {
+      printf("pacing watchdog: back to full rate after remedy %d\n", sUnstickLast);
+      fflush(stdout);
+      sUnstickLast = -1;
+      sUnstickStep = 0;
+    }
+  }
+}
