+// Whether a hardware window's horizontal range holds screenX. On a wide layer a window that
+// starts at the screen's left edge (0) continues across the left side, and one that reaches its
+// right edge (255) across the right side (the HM cut-in's band spans the whole screen)
+static bool WideWindowContains(int screenX, int left, int right) {
+  if (sWideOut != nullptr) {
+    if (left == 0 && screenX < 0) {
+      screenX = 0;
+    }
+    if (right >= SIM_NDS_SCREEN_WIDTH - 1 && screenX >= SIM_NDS_SCREEN_WIDTH - 1) {
+      screenX = SIM_NDS_SCREEN_WIDTH - 2;
+    }
+  }
+  return screenX >= 0 && screenX < SIM_NDS_SCREEN_WIDTH && screenX >= left && screenX < right;
+}
