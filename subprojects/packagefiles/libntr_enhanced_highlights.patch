+R""(
+#version 420 core
+
+// Enhanced graphics' sun highlights, at the DS's own resolution (one fragment per DS pixel, so the light keeps the pixel grid):
+// from the depth the 3D shader left in the attribute texture the surface's normal is rebuilt in view space (differences of
+// the neighbours' positions, read from the side with the smaller jump so an edge doesn't bend it), and a surface that is
+// flat (the normal agrees at one and two pixels' reach) and not the ground (walls, roof slopes) gets
+//   a specular glint where its normal is near the half vector between the sun and the eye,
+//   a lift where it faces the sun, and
+//   a fresnel sheen where it is seen at a graze,
+// all in the sun's colour. A sprite gets a rim: its outermost pixels on the side toward the sun. Nothing in shadow (the sun
+// shadows' mask) is lit. The result is two numbers per DS pixel for the next pass, at full resolution: rgb how much the
+// pixel's own colour is brightened (so a texture's detail and a black outline stay as drawn), a how much of the sun's colour
+// is added (the sprites' rim, which has to show on outlines).
+uniform sampler2D attrTexture;   // polygon ID * 4 + 1 for a sprite in r, the depth's high and low bytes in g and b, a set where opaque
+uniform sampler2D shadowTexture; // the sun shadows' mask (r: in shadow), when it was made this frame
+uniform int useShadow;
+uniform ivec2 origin;
+uniform int pixelStep;
+uniform ivec2 dsSize;
+uniform vec4 projection;         // m00, m11, m22, m32
+uniform float xScale;
+uniform vec3 toSun;              // view space, unit length
+uniform vec3 upView;             // the world's up in view space, unit length
+uniform vec3 sunColor;           // the sun's light, scaled by how strong it is now
+uniform int debugNormals;        // SIM_HIGHLIGHT_DEBUG=1: the normals as colour
+out vec4 color;
+
+// false: nothing opaque there, or off the screen. dist: view distance; sprite: a sprite's pixel
+int fetchedPolygonId; // the polygon ID of the pixel Fetch read last
+
+bool Fetch(ivec2 ds, out float dist, out bool sprite)
+{
+    dist = 0.0;
+    sprite = false;
+    if (ds.x < 0 || ds.y < 0 || ds.x >= dsSize.x || ds.y >= dsSize.y) {
+        return false;
+    }
+    ivec4 a = ivec4(texelFetch(attrTexture, origin + ds * pixelStep + ivec2(pixelStep / 2), 0) * 255.0 + 0.5);
+    if (a.a == 0) {
+        return false;
+    }
+    sprite = (a.r & 1) == 1;
+    fetchedPolygonId = a.r >> 2;
+    float ndcz = float(a.g * 256 + a.b) / 65535.0 * 2.0 - 1.0;
+    dist = projection.w / (ndcz + projection.z);
+    return true;
+}
+
+vec3 ViewPosition(ivec2 ds, float dist)
+{
+    vec2 ndc = ((vec2(ds) + 0.5) / vec2(dsSize)) * 2.0 - 1.0;
+    return vec3(ndc.x / xScale * dist / projection.x, ndc.y * dist / projection.y, -dist);
+}
+
+// A neighbour usable for a difference: opaque, not a sprite, and not across an edge
+bool Usable(ivec2 ds, float distHere, out vec3 position)
+{
+    float d;
+    bool sprite;
+    position = vec3(0.0);
+    if (!Fetch(ds, d, sprite) || sprite || abs(d - distHere) > 6.0) {
+        return false;
+    }
+    position = ViewPosition(ds, d);
+    return true;
+}
+
+// The surface's normal toward the viewer at a reach of `reach` pixels; ok false at an edge
+vec3 Normal(ivec2 p, float dist, vec3 here, int reach, out bool ok)
+{
+    vec3 r, l, u, d;
+    bool hasR = Usable(p + ivec2(reach, 0), dist, r), hasL = Usable(p - ivec2(reach, 0), dist, l);
+    bool hasU = Usable(p + ivec2(0, reach), dist, u), hasD = Usable(p - ivec2(0, reach), dist, d);
+    vec3 dx = vec3(0.0), dy = vec3(0.0);
+    ok = true;
+    if (hasR && hasL) {
+        dx = r - l;
+    } else if (hasR) {
+        dx = r - here;
+    } else if (hasL) {
+        dx = here - l;
+    } else {
+        ok = false;
+    }
+    if (hasU && hasD) {
+        dy = u - d;
+    } else if (hasU) {
+        dy = u - here;
+    } else if (hasD) {
+        dy = here - d;
+    } else {
+        ok = false;
+    }
+    vec3 n = cross(dx, dy);
+    if (!ok || dot(n, n) < 1e-6) {
+        ok = false;
+        return vec3(0.0, 0.0, 1.0);
+    }
+    n = normalize(n);
+    return dot(n, -here) < 0.0 ? -n : n;
+}
+
+void main()
+{
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    float dist;
+    bool sprite;
+    vec3 light = vec3(0.0);
+    float rim = 0.0;
+    vec3 shown = vec3(0.0);
+    if (Fetch(p, dist, sprite)) {
+        // Buildings carry polygon IDs the ground and the trees don't (the DS gives them to outline them): only those glint
+        bool building = fetchedPolygonId != 0;
+        if (sprite) {
+            // The rim: the pixel's neighbour toward the sun on screen isn't a sprite's pixel
+            vec2 s = normalize(vec2(toSun.x, toSun.y) + vec2(1e-4));
+            ivec2 towardSun = ivec2(abs(s.x) > 0.38 ? int(sign(s.x)) : 0, abs(s.y) > 0.38 ? int(sign(s.y)) : 0);
+            float d2;
+            bool sprite2;
+            if (!(Fetch(p + towardSun, d2, sprite2) && sprite2)) {
+                rim = 0.4;
+            }
+        } else {
+            vec3 here = ViewPosition(p, dist);
+            bool ok1, ok2;
+            vec3 n = Normal(p, dist, here, 1, ok1);
+            vec3 n2 = Normal(p, dist, here, 2, ok2);
+            shown = n * 0.5 + 0.5;
+            // Flat (the same normal at two reaches) and not the ground
+            if (building && ok1 && ok2 && dot(n, n2) > 0.985 && dot(n, upView) < 0.9) {
+                vec3 eye = normalize(-here);
+                vec3 halfway = normalize(toSun + eye);
+                float facing = max(dot(n, toSun), 0.0);
+                float glint = pow(max(dot(n, halfway), 0.0), 48.0);
+                float sheen = pow(1.0 - max(dot(n, eye), 0.0), 2.0) * (0.3 + 0.7 * facing);
+                light = sunColor * clamp(0.9 * glint + 0.3 * facing * facing + 0.25 * sheen, 0.0, 0.8);
+            }
+        }
+        if (useShadow == 1 && texelFetch(shadowTexture, p, 0).r > 0.5) {
+            light = vec3(0.0);
+            rim = 0.0;
+        }
+    }
+    if (debugNormals == 2) {
+        ivec4 a = ivec4(texelFetch(attrTexture, origin + p * pixelStep + ivec2(pixelStep / 2), 0) * 255.0 + 0.5);
+        int id = a.r >> 2;
+        shown = a.a == 0 ? vec3(0.0) : vec3(float(id & 1), float((id >> 1) & 1), float((id >> 2) & 1)) * 0.6 + 0.2 * float((id >> 3) & 3);
+    }
+    color = vec4(debugNormals >= 1 ? shown : light, rim);
+}
+)""
