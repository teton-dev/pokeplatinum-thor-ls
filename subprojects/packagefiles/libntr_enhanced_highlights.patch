+R""(
+#version 420 core
+
+// Enhanced graphics' sun highlights, second pass: at full resolution what the first pass found. Drawn twice: mode 0 brightens
+// the pixel's own colour (the blend multiplies and adds: dst * (1 + light)), mode 1 adds the sun's colour for the rim. One
+// texel of the light texture is a DS pixel, never filtered, so the light keeps the pixel grid.
+uniform sampler2D lightTexture;
+uniform ivec2 origin;
+uniform int pixelStep;
+uniform int mode;
+uniform vec3 sunColor;
+out vec4 color;
+
+void main()
+{
+    vec4 light = texelFetch(lightTexture, (ivec2(gl_FragCoord.xy) - origin) / pixelStep, 0);
+    if (mode == 0) {
+        if (dot(light.rgb, light.rgb) < 1e-5) {
+            discard;
+        }
+        color = vec4(light.rgb, 1.0);
+    } else {
+        if (light.a < 0.01) {
+            discard;
+        }
+        color = vec4(sunColor * light.a, 1.0);
+    }
+}
+)""
