+// Enhanced graphics, the game-neutral part of the game side: see include/port/enhanced_scene.h
+#include "port/enhanced_scene.h"
+
+#include <nitro.h>
+#include <nnsys.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef __ANDROID__
+#include <sys/system_properties.h>
+#endif
+#include <simulator/config/sim_config.h>
+#include <simulator/sim.h>
+
+#define TILE_SIZE FX32_CONST(16)
+
+typedef struct {
+    int hour;
+    u8 r, g, b;
+    u8 vignette;
+} LightKey;
+
+// The light at each hour, between which it is blended by the minute. Gentle: the games' own area light already
+// darkens the night and warms the evening, so this is a grade on top of it, not a replacement.
+static const LightKey sKeys[] = {
+    { 0, 175, 190, 235, 70 },
+    { 5, 185, 195, 235, 60 },
+    { 7, 255, 228, 205, 30 },
+    { 9, 255, 255, 255, 0 },
+    { 16, 255, 255, 255, 0 },
+    { 18, 255, 214, 176, 35 },
+    { 20, 190, 180, 215, 55 },
+    { 22, 175, 190, 235, 70 },
+    { 24, 175, 190, 235, 70 },
+};
+
+// The air by the hour: the haze's colour and its share at the top of the screen, and how brightly the glowing parts
+// (lamps, lit windows) shine: the luminance they must pass and how strongly they glow
+typedef struct {
+    int hour;
+    float hazeR, hazeG, hazeB, haze;
+    float bloomThreshold, bloomStrength;
+} AirKey;
+
+static const AirKey sAir[] = {
+    { 0, 0.30f, 0.38f, 0.60f, 0.28f, 0.70f, 0.80f },
+    { 5, 0.30f, 0.38f, 0.60f, 0.28f, 0.70f, 0.80f },
+    { 7, 0.95f, 0.70f, 0.55f, 0.30f, 0.90f, 0.35f },
+    { 9, 0.75f, 0.85f, 0.97f, 0.20f, 0.97f, 0.12f },
+    { 16, 0.78f, 0.86f, 0.97f, 0.20f, 0.97f, 0.12f },
+    { 18, 1.00f, 0.66f, 0.45f, 0.32f, 0.92f, 0.35f },
+    { 20, 0.35f, 0.38f, 0.62f, 0.28f, 0.72f, 0.75f },
+    { 24, 0.30f, 0.38f, 0.60f, 0.28f, 0.70f, 0.80f },
+};
+
+// The sun's shadows by the hour: they fall to the left in the morning (the sun in the east) and the right in the
+// evening, short at noon and long when it is low, with none at night
+static BOOL sSunShadows = FALSE;
+static BOOL sSunLit = FALSE; // the sun is up (and a setting that reads the game's camera is on)
+// Toward the sun, in the world (x east, y up, z south), unit length
+static float sSunWorld[3] = { 0.0f, 1.0f, 0.0f };
+// The sprites' shadows' lean (SIM_SetEnhancedSun): sideways in NDC x per NDC y of height, and up the screen per height
+static float sSpriteShear[2] = { 0.0f, 0.24f };
+static float sSunShadowAlpha = 0.0f; // how dark the sun's sprite shadows are now (0: none), for the hand-over at dusk
+
+// This frame's camera and projection as floats (row vectors), for EnhancedScene_NearView and the lamps
+static float sViewCamera[4][3], sViewProjection[4][4];
+static BOOL sViewSet = FALSE;
+
+// The map's fog and forest sunlight (NULL: none), the hour's share of night, and the ground they lie on
+static const EnhancedFogLook *sFog = NULL;
+static const EnhancedSunPatchLook *sPatches = NULL;
+static float sNight = 0.0f;     // 0 day to 1 night
+static float sHour = 12.0f;
+static float sGround = 0.0f;    // the ground's height under the player, eased (world units)
+static BOOL sGroundSet = FALSE;
+static u32 sFrames = 0;         // the drift's clock (field frames)
+
+// Lamps: how much they are lit now, 0 to 1 (by the hour, outdoors only), and whether this frame wants them
+static float sLampNight = 0.0f;
+static BOOL sLampsWanted = FALSE;
+
+// This frame's lamps in the world (from libntr once the land is drawn), for the sprites' shadows
+typedef struct {
+    float x, y, z, radius;
+} LampSeen;
+
+static LampSeen sLampsSeen[SIM_ENHANCED_LAMPS_MAX];
+static int sLampsSeenCount = 0;
+
+static void SetAir(float hour, float shaft)
+{
+    AirKey now = sAir[0];
+    for (int i = 0; i < (int)(sizeof(sAir) / sizeof(sAir[0])) - 1; i++) {
+        if (hour >= sAir[i].hour && hour < sAir[i + 1].hour) {
+            const float t = (hour - sAir[i].hour) / (float)(sAir[i + 1].hour - sAir[i].hour);
+            now.hazeR = sAir[i].hazeR + (sAir[i + 1].hazeR - sAir[i].hazeR) * t;
+            now.hazeG = sAir[i].hazeG + (sAir[i + 1].hazeG - sAir[i].hazeG) * t;
+            now.hazeB = sAir[i].hazeB + (sAir[i + 1].hazeB - sAir[i].hazeB) * t;
+            now.haze = sAir[i].haze + (sAir[i + 1].haze - sAir[i].haze) * t;
+            now.bloomThreshold = sAir[i].bloomThreshold + (sAir[i + 1].bloomThreshold - sAir[i].bloomThreshold) * t;
+            now.bloomStrength = sAir[i].bloomStrength + (sAir[i + 1].bloomStrength - sAir[i].bloomStrength) * t;
+            break;
+        }
+    }
+    SIM_SetEnhancedAtmosphere(shaft, now.hazeR, now.hazeG, now.hazeB, now.haze);
+    SIM_SetEnhancedBloom(now.bloomThreshold, now.bloomStrength);
+}
+
+static u8 Lerp(u8 a, u8 b, int t, int span)
+{
+    return (u8)(a + ((int)b - (int)a) * t / span);
+}
+
+// The world's x axis in view space (row vectors: the camera's first row), unit length; FALSE when degenerate
+static BOOL CameraEast(const MtxFx43 *camera, float *east)
+{
+    const float k = 1.0f / 4096.0f;
+    const float ex = camera->_00 * k, ey = camera->_01 * k, ez = camera->_02 * k;
+    const float length = sqrtf(ex * ex + ey * ey + ez * ez);
+    if (length < 0.0001f) {
+        return FALSE;
+    }
+    east[0] = ex / length;
+    east[1] = ey / length;
+    east[2] = ez / length;
+    return TRUE;
+}
+
+// The fog for this frame, with the camera just set (libntr takes the world's up and origin from the same frame's calls)
+static void SendFog(const float *east)
+{
+    if (sFog == NULL || east == NULL || !SIM_GetConfigPtr()->enhancedFog) {
+        SIM_SetEnhancedFog(NULL);
+        return;
+    }
+    const EnhancedFogLook *look = sFog;
+    const float n = sNight;
+    SIM_EnhancedFog fog = {
+        .r = look->dayR + (look->nightR - look->dayR) * n,
+        .g = look->dayG + (look->nightG - look->dayG) * n,
+        .b = look->dayB + (look->nightB - look->dayB) * n,
+        .groundDensity = look->groundDensity,
+        .groundFalloff = look->groundFalloff,
+        .groundLevel = sGround,
+        .distanceDensity = look->distanceDensity,
+        .distanceStart = look->distanceStart,
+        .noiseScale = look->noiseScale,
+        .noiseAmount = look->noiseAmount,
+        .windX = look->windX,
+        .windZ = look->windZ,
+        .time = sFrames / 60.0f,
+        .eastX = east[0],
+        .eastY = east[1],
+        .eastZ = east[2],
+    };
+    SIM_SetEnhancedFog(&fog);
+}
+
+// The forest's sunlight on its floor: by day only; warmer when the sun is low
+static void SendSunPatches(const float *east)
+{
+    const float day = 1.0f - sNight;
+    if (sPatches == NULL || east == NULL || day <= 0.0f) {
+        SIM_SetEnhancedSunPatches(NULL);
+        return;
+    }
+    const EnhancedSunPatchLook *look = sPatches;
+    const float fromNoon = fabsf(sHour - 12.0f);
+    const float low = fromNoon / 6.0f > 1.0f ? 1.0f : fromNoon / 6.0f;
+    SIM_EnhancedSunPatches patches = {
+        .r = 1.0f,
+        .g = 0.82f - 0.12f * low,
+        .b = 0.40f - 0.15f * low,
+        .strength = look->strength * day,
+        .glow = look->glow * day,
+        .size = look->size,
+        .coverage = look->coverage,
+        .groundLevel = sGround,
+        .groundFade = look->fade,
+        .windX = 2.0f,
+        .windZ = 0.7f,
+        .time = sFrames / 60.0f,
+        .eastX = east[0],
+        .eastY = east[1],
+        .eastZ = east[2],
+    };
+    SIM_SetEnhancedSunPatches(&patches);
+}
+
+// A texture's VRAM address in bytes, as libntr sees the polygons' TEXIMAGE_PARAM (the dictionary's parameter plus the
+// texture block's place, as NNS binds it to a material); 0 when the set has no such texture or isn't in VRAM
+static u32 TextureAddress(const NNSG3dResTex *set, const char *name)
+{
+    if (set == NULL) {
+        return 0;
+    }
+    NNSG3dResName resName;
+    memset(&resName, 0, sizeof(resName));
+    strncpy(resName.name, name, sizeof(resName.name));
+    const NNSG3dResDictTexData *data = NNS_G3dGetTexDataByName(set, &resName);
+    if (data == NULL) {
+        return 0;
+    }
+    const BOOL compressed = ((data->texImageParam & REG_G3_TEXIMAGE_PARAM_TEXFMT_MASK) >> REG_G3_TEXIMAGE_PARAM_TEXFMT_SHIFT)
+        == GX_TEXFMT_COMP4x4;
+    const NNSGfdTexKey key = compressed ? set->tex4x4Info.vramKey : set->texInfo.vramKey;
+    if (key == 0) {
+        return 0;
+    }
+    const u32 param = data->texImageParam + (NNS_GfdGetTexKeyAddr(key) >> NNS_GFD_TEXKEY_ADDR_SHIFT);
+    return (param & 0xFFFF) << 3;
+}
+
+// The lamps' textures for this frame, before the land is drawn (in the map's texture sets)
+static void SendLampTextures(const NNSG3dResTex *const *sets, int setCount, const EnhancedLampLook *lamps, int lampCount)
+{
+    if (!sLampsWanted || sets == NULL || lamps == NULL) {
+        SIM_SetLampTextures(NULL, 0);
+        return;
+    }
+    SIM_LampTexture textures[SIM_LAMP_TEXTURES_MAX];
+    int count = 0;
+    for (int i = 0; i < lampCount; i++) {
+        for (int s = 0; s < setCount && count < SIM_LAMP_TEXTURES_MAX; s++) {
+            const u32 address = TextureAddress(sets[s], lamps[i].texture);
+            if (address == 0) {
+                continue;
+            }
+            SIM_LampTexture *texture = &textures[count++];
+            texture->textureOffset = address;
+            texture->radius = lamps[i].radius;
+            texture->r = lamps[i].r * sLampNight;
+            texture->g = lamps[i].g * sLampNight;
+            texture->b = lamps[i].b * sLampNight;
+        }
+    }
+    SIM_SetLampTextures(textures, count);
+    // Tests: POKEPLATINUM_LAMP_LOG=1 (POKEHEARTGOLD_LAMP_LOG=1) also logs the textures named, when they change
+    static u32 sLoggedAddress = 0xFFFFFFFF;
+    const u32 address = count > 0 ? textures[0].textureOffset : 0;
+    if (address != sLoggedAddress && (getenv("POKEPLATINUM_LAMP_LOG") != NULL || getenv("POKEHEARTGOLD_LAMP_LOG") != NULL)) {
+        sLoggedAddress = address;
+        printf("[lamps] %d lamp textures, the first at 0x%05x\n", count, (unsigned)address);
+        fflush(stdout);
+    }
+}
+
+// Once the land is drawn: the lamps libntr found, back in the world (the camera's rows are the world's axes in view space:
+// world = (view - origin) times their transpose), for the sprites drawn after
+static void TakeFrameLamps(void)
+{
+    sLampsSeenCount = 0;
+    if (!sLampsWanted || !sViewSet) {
+        return;
+    }
+    SIM_EnhancedLamp lamps[SIM_ENHANCED_LAMPS_MAX];
+    const int count = SIM_GetFrameLamps(lamps, SIM_ENHANCED_LAMPS_MAX);
+    for (int i = 0; i < count; i++) {
+        const float v[3] = { lamps[i].x - sViewCamera[3][0], lamps[i].y - sViewCamera[3][1], lamps[i].z - sViewCamera[3][2] };
+        LampSeen *seen = &sLampsSeen[sLampsSeenCount++];
+        seen->x = v[0] * sViewCamera[0][0] + v[1] * sViewCamera[0][1] + v[2] * sViewCamera[0][2];
+        seen->y = v[0] * sViewCamera[1][0] + v[1] * sViewCamera[1][1] + v[2] * sViewCamera[1][2];
+        seen->z = v[0] * sViewCamera[2][0] + v[1] * sViewCamera[2][1] + v[2] * sViewCamera[2][2];
+        seen->radius = lamps[i].radius;
+    }
+    // Tests: the lamp log lists the lamps found, each time their count changes
+    static int sLoggedCount = -1;
+    if (count != sLoggedCount && (getenv("POKEPLATINUM_LAMP_LOG") != NULL || getenv("POKEHEARTGOLD_LAMP_LOG") != NULL)) {
+        sLoggedCount = count;
+        printf("[lamps] %d found\n", count);
+        for (int i = 0; i < sLampsSeenCount; i++) {
+            printf("[lamps]   at %.0f %.0f %.0f (tile %d, %d) r %.2f\n", sLampsSeen[i].x, sLampsSeen[i].y, sLampsSeen[i].z,
+                (int)floorf(sLampsSeen[i].x / 16.0f), (int)floorf(sLampsSeen[i].z / 16.0f), lamps[i].r);
+        }
+        fflush(stdout);
+    }
+}
+
+// libntr reads the lamp's shadow as each sprite's polygons are submitted, so the commands already sent are drawn before it
+// changes; when it doesn't change (most sprites, and every one by day), nothing is flushed
+static void SetSpriteLampShadow(float shearX, float shearY, float alpha)
+{
+    static float sSent[3] = { 0.0f, 0.0f, 0.0f };
+    if (shearX == sSent[0] && shearY == sSent[1] && alpha == sSent[2]) {
+        return;
+    }
+    sSent[0] = shearX;
+    sSent[1] = shearY;
+    sSent[2] = alpha;
+    NNS_G3dGeFlushBuffer();
+    SIM_SetSpriteShadowLight(shearX, shearY, alpha);
+}
+
+// The shadow a lamp gives an object standing at position: its darkness (0: none, as far from every lamp, or while the sun's
+// is darker at dusk and dawn) and, when shearX is given, its lean on the screen as SIM_SetEnhancedSun's
+static float LampShadow(const VecFx32 *position, float *shearX, float *shearY)
+{
+    if (sLampsSeenCount == 0 || position == NULL) {
+        return 0.0f;
+    }
+    const float px = position->x / 4096.0f, py = position->y / 4096.0f, pz = position->z / 4096.0f;
+    // The lamp that lights this sprite most: it casts the shadow (one shadow, the strongest light's)
+    float bestWeight = 0.0f, bestDx = 0.0f, bestDz = 0.0f, bestHeight = 1.0f;
+    for (int i = 0; i < sLampsSeenCount; i++) {
+        const LampSeen *seen = &sLampsSeen[i];
+        const float dx = px - seen->x, dz = pz - seen->z;
+        const float reach = seen->radius * 1.25f;
+        const float d2 = (dx * dx + dz * dz) / (reach * reach);
+        const float height = seen->y - py;
+        if (d2 >= 1.0f || height < 8.0f) {
+            continue; // out of its reach, or a light no higher than the sprite casts nothing useful
+        }
+        const float weight = 1.0f - d2; // still clear a few tiles from a lamp, gone past its reach
+        if (weight > bestWeight) {
+            bestWeight = weight;
+            bestDx = dx;
+            bestDz = dz;
+            bestHeight = height;
+        }
+    }
+    const float alpha = 0.6f * bestWeight * sLampNight;
+    // At dusk and dawn the stronger of the two casts: the sun's until the lamp's is darker (no pop: both fade)
+    if (alpha < 0.02f || alpha <= sSunShadowAlpha) {
+        return 0.0f;
+    }
+    if (shearX != NULL) {
+        // Away from the lamp: per unit of the sprite's height, the shadow reaches (distance / the light's height) along
+        // the ground (a point light over a short figure), at most 1.6 times the height. Then on the screen as the sun's
+        // shadows are (EnhancedScene_SetCamera's sums, the other way): x by the camera's east scale, northward by its
+        // pitch
+        float east = bestDx / bestHeight, north = -bestDz / bestHeight;
+        const float reach = sqrtf(east * east + north * north);
+        if (reach > 1.6f) {
+            east *= 1.6f / reach;
+            north *= 1.6f / reach;
+        }
+        *shearX = 0.75f * east * sViewCamera[0][0];
+        *shearY = north * -sViewCamera[2][1];
+    }
+    return alpha;
+}
+
+void EnhancedScene_SpriteLampShadow(const VecFx32 *position)
+{
+    float shearX = 0.0f, shearY = 0.0f;
+    const float alpha = LampShadow(position, &shearX, &shearY);
+    SetSpriteLampShadow(alpha > 0.0f ? shearX : 0.0f, alpha > 0.0f ? shearY : 0.0f, alpha);
+}
+
+BOOL EnhancedScene_LampShadowShown(const VecFx32 *position)
+{
+    // Once the lamp's shadow is clear; fainter (at the edge of a lamp's reach) the blob stays as well, so there's always
+    // some shadow under the feet
+    return LampShadow(position, NULL, NULL) >= 0.12f;
+}
+
+void EnhancedScene_SpriteLampShadowsEnd(void)
+{
+    SetSpriteLampShadow(0.0f, 0.0f, 0.0f);
+}
+
+void EnhancedScene_SetCamera(const MtxFx44 *projection, const MtxFx43 *camera)
+{
+    sViewSet = FALSE;
+    if (projection == NULL || camera == NULL) {
+        return;
+    }
+    const float k = 1.0f / 4096.0f;
+    for (int r = 0; r < 4; r++) {
+        for (int c = 0; c < 3; c++) {
+            sViewCamera[r][c] = camera->m[r][c] * k;
+        }
+        for (int c = 0; c < 4; c++) {
+            sViewProjection[r][c] = projection->m[r][c] * k;
+        }
+    }
+    sViewSet = TRUE;
+    // A new frame of the field: its lamps are found again as the land is drawn
+    sLampsSeenCount = 0;
+    // The camera for the passes that rebuild the scene from its depth (the water's mirror, fog, forest sunlight), by day
+    // and by night
+    {
+        const float ux = camera->_10 * k, uy = camera->_11 * k, uz = camera->_12 * k;
+        const float upLength = sqrtf(ux * ux + uy * uy + uz * uz);
+        if (upLength > 0.0001f) {
+            SIM_SetEnhancedCamera(projection->_00 * k, projection->_11 * k, projection->_22 * k, projection->_32 * k,
+                ux / upLength, uy / upLength, uz / upLength);
+        }
+    }
+    // The world's origin in view space (row vectors: the translation row), which holds the shadow map's texels still
+    SIM_SetEnhancedWorldOrigin(camera->_30 * k, camera->_31 * k, camera->_32 * k);
+    float east[3];
+    const BOOL hasEast = CameraEast(camera, east);
+    SendFog(hasEast ? east : NULL);
+    SendSunPatches(hasEast ? east : NULL);
+    if (!sSunLit) {
+        return;
+    }
+    float x = sSunWorld[0], y = sSunWorld[1], z = sSunWorld[2];
+    // The 3D's sun casts as the sprites' shadows lean: a thing as tall as a sprite throws a shadow as long, the same way.
+    // A sprite's shadow moves (4/3) shx (NDC x is 4/3 of NDC y on a 4:3 screen) across and shy up the screen per unit of
+    // its height, in view units; on the ground that is shx' east per unit of height (the camera has no yaw: view x is
+    // world x) and, northward, whatever reaches shy up the screen through the camera's pitch (view y of world z, _21)
+    if (camera->_00 > 0 && camera->_21 < -0.05f * 4096.0f) {
+        const float eastward = (4.0f / 3.0f) * sSpriteShear[0] / (camera->_00 * k);
+        const float north = sSpriteShear[1] / (-camera->_21 * k);
+        const float n = sqrtf(eastward * eastward + 1.0f + north * north);
+        x = -eastward / n;
+        y = 1.0f / n;
+        z = north / n;
+    }
+    // The matrices are the DS's, for row vectors: a world direction is multiplied on the left
+    float vx = (x * camera->_00 + y * camera->_10 + z * camera->_20) * k;
+    float vy = (x * camera->_01 + y * camera->_11 + z * camera->_21) * k;
+    float vz = (x * camera->_02 + y * camera->_12 + z * camera->_22) * k;
+    const float length = sqrtf(vx * vx + vy * vy + vz * vz);
+    if (length < 0.0001f) {
+        return;
+    }
+    // The world's up in view space, for libntr to tell the ground from walls and roofs
+    float ux = camera->_10 * k, uy = camera->_11 * k, uz = camera->_12 * k;
+    const float upLength = sqrtf(ux * ux + uy * uy + uz * uz);
+    if (upLength < 0.0001f) {
+        return;
+    }
+    SIM_SetEnhancedShadowCamera(projection->_00 * k, projection->_11 * k, projection->_22 * k, projection->_32 * k,
+        vx / length, vy / length, vz / length, ux / upLength, uy / upLength, uz / upLength);
+}
+
+BOOL EnhancedScene_WantsOffScreenCasters(void)
+{
+    // The sun's shadows of things off the screen reach onto it (the water's planar mirror, SIM_WATER_METHOD=planar, would
+    // show them too, but the default flip doesn't use them: not worth their cost for it)
+    return sSunShadows;
+}
+
+BOOL EnhancedScene_NearView(const VecFx32 *position)
+{
+    if (!sViewSet) {
+        return FALSE;
+    }
+    const float p[3] = { position->x / 4096.0f, position->y / 4096.0f, position->z / 4096.0f };
+    float view[3];
+    for (int c = 0; c < 3; c++) {
+        view[c] = p[0] * sViewCamera[0][c] + p[1] * sViewCamera[1][c] + p[2] * sViewCamera[2][c] + sViewCamera[3][c];
+    }
+    float clip[4];
+    for (int c = 0; c < 4; c++) {
+        clip[c] = view[0] * sViewProjection[0][c] + view[1] * sViewProjection[1][c] + view[2] * sViewProjection[2][c]
+            + sViewProjection[3][c];
+    }
+    if (clip[3] <= 0.0f) {
+        return FALSE;
+    }
+    // A prop's origin is at its foot: one up to about half the screen's width or height beyond an edge can still throw
+    // a shadow (or a reflection) onto it
+    return fabsf(clip[0]) <= clip[3] * 2.0f && fabsf(clip[1]) <= clip[3] * 2.0f;
+}
+
+void EnhancedScene_LandDrawing(BOOL drawing)
+{
+    // The commands already sent are drawn as they were
+    NNS_G3dGeFlushBuffer();
+    SIM_SetHideBuiltInShadows(drawing && sSunShadows);
+    SIM_SetLandDrawing(drawing);
+    if (!drawing) {
+        TakeFrameLamps(); // the land and its props, and so their lamps, have been drawn
+    }
+}
