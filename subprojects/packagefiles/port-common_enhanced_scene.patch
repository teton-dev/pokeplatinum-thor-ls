+#ifndef PORT_COMMON_PORT_ENHANCED_SCENE_H
+#define PORT_COMMON_PORT_ENHANCED_SCENE_H
+
+// Enhanced graphics, the game-neutral part of the game side (Settings > Display, libntr's settings; plan and findings:
+// pokeplatinum's docs/thor/dev/enhanced-graphics.md). libntr draws the effects; this tells it what the scene wants:
+// the time of day's light and air, the sun (sprite shadows, the 3D shadow map, highlights), fog, forest sunlight,
+// water, lamps. Each game keeps a small adapter (Platinum src/port/enhanced_graphics.c, HGSS
+// lib/port/enhanced_graphics.c) that supplies what only it knows: the hour, whether the map is outdoors, the per-map
+// looks, the tiles that are water and the texture sets the lamps are in.
+
+#include <nitro/types.h>
+#include <nitro/fx/fx.h>
+#include <nnsys/g3d/binres/res_struct.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// A map's fog, by day and by night (blended by the hour). Lengths are world units (a tile is 16).
+typedef struct EnhancedFogLook {
+    float dayR, dayG, dayB, nightR, nightG, nightB;
+    float groundDensity, groundFalloff; // dense at the ground, thinning by e every groundFalloff units up
+    float distanceDensity, distanceStart;
+    float noiseScale, noiseAmount, windX, windZ;
+} EnhancedFogLook;
+
+// A forest's patches of sunlight on its floor (libntr's SIM_SetEnhancedSunPatches): by day only, warmer when the sun
+// is low. fade: world units above the floor over which they fade out (so treetops and roofs stay unlit)
+typedef struct EnhancedSunPatchLook {
+    float strength, glow, size, coverage, fade;
+} EnhancedSunPatchLook;
+
+// A texture that is a lamp's in the map's texture sets: libntr finds the lamps from the polygons drawn with it
+// (SIM_SetLampTextures). radius: world units the light reaches; r, g, b: its colour times its strength
+typedef struct EnhancedLampLook {
+    const char *texture;
+    float radius;
+    float r, g, b;
+} EnhancedLampLook;
+
+// What the game shows now, once per main loop iteration
+typedef struct EnhancedSceneState {
+    BOOL field;                          // a field map is shown (FALSE in menus and battles: nothing is drawn)
+    BOOL outdoors;                       // the sun lights it (light, shadows, air, lamps)
+    float hour;                          // 0 to 24 (EnhancedScene_Hour)
+    const EnhancedFogLook *fog;          // this map's fog, or NULL
+    const EnhancedSunPatchLook *patches; // this map's forest sunlight, or NULL
+} EnhancedSceneState;
+
+void EnhancedScene_Update(const EnhancedSceneState *state);
+
+// The hour the light follows: clockHour (the game's clock), or in tests the environment variable testEnv (H or H.5),
+// or on Android `adb shell setprop debug.eterna.hour H` (empty to clear; looked up about once a second)
+float EnhancedScene_Hour(float clockHour, const char *testEnv);
+
+// In the field map's 3D render, before the camera is set: the player's ground (world units; the fog and the forest's
+// sunlight lie on it, eased) and the map's texture sets, in which the lamps' textures are looked up (as NNS binds them)
+void EnhancedScene_FieldDrawing(float groundY, const NNSG3dResTex *const *textureSets, int setCount,
+    const EnhancedLampLook *lamps, int lampCount);
+
+// In the field map's 3D render, once the camera is set and before the map is drawn: libntr's passes that rebuild the
+// scene from its depth need the game's projection and camera; the sun's direction follows the sprites' shadows
+void EnhancedScene_SetCamera(const MtxFx44 *projection, const MtxFx43 *camera);
+
+// Around the land and its props being drawn: they are the shadow map's (and the planar mirror's) casters, their own
+// faint shadow polygons are not drawn while the sun's are shown, and the lamps are found in them
+void EnhancedScene_LandDrawing(BOOL drawing);
+// Around other models that should cast the sun's shadows (Platinum's signposts and mailboxes)
+void EnhancedScene_CasterDrawing(BOOL drawing);
+// The map's props just off the screen are wanted too (as casters: libntr keeps them before clipping), for a game that
+// culls its props to the screen
+BOOL EnhancedScene_WantsOffScreenCasters(void);
+// Is a point on the screen or within about half the screen of it, with this frame's camera
+BOOL EnhancedScene_NearView(const VecFx32 *position);
+
+// The sun casts the objects' shadows now (the game's own blob shadows stay hidden then)
+BOOL EnhancedScene_SunShadowsShown(void);
+
+// Inside the billboards' shadow bracket (libntr's SIM_SetSpriteShadow), before a sprite that casts: its shadow from the
+// nearest lamp instead of the sun's, at night (SIM_SetSpriteShadowLight); ..._SpriteLampShadowsEnd after the last one
+void EnhancedScene_SpriteLampShadow(const VecFx32 *position);
+void EnhancedScene_SpriteLampShadowsEnd(void);
+// A lamp casts the shadow of an object standing there now (its blob shadow is hidden then, as under the sun's)
+BOOL EnhancedScene_LampShadowShown(const VecFx32 *position);
+
+// The water tiles, as the game knows them
+typedef struct EnhancedWaterQuery {
+    void *context;
+    // A tile of the loaded map that is water (a reflective or surfable tile). Must stay inside what the game has loaded:
+    // Platinum's lookup outside its map matrix set a link error (a white-screen reset)
+    BOOL (*isWater)(void *context, int x, int z);
+    // The height of the tile's surface (world units as fx32)
+    fx32 (*height)(void *context, int x, int z);
+    int playerX, playerZ; // the player's tile
+    int mapId;            // a change of map finds the water again
+} EnhancedWaterQuery;
+
+// In the field map's 3D render, after the scene: the water tiles around the player as the water mask (libntr draws the
+// reflections from it); with Water reflections off (or query NULL), nothing
+void EnhancedScene_DrawWaterMask(const EnhancedWaterQuery *query);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // PORT_COMMON_PORT_ENHANCED_SCENE_H
