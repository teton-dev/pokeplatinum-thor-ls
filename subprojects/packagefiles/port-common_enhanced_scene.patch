+void EnhancedScene_CasterDrawing(BOOL drawing)
+{
+    NNS_G3dGeFlushBuffer();
+    SIM_SetSunCasters(drawing); // (kept for the water's mirror image too: libntr keeps them only when one wants them)
+}
