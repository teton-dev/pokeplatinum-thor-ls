+// camera to the surface, the lowest ones (the air within a couple of tiles of the ground), are each marched toward the sun
+// through the depth the 3D shader left in the attribute texture, as the sun shadows are; a point that meets something nearer
+// than itself is in shadow (the shadow of a house or a tree reaches up into the air), a point that does not is lit air that
+// scatters the sun's light toward the eye. The result is the lit share, weighted toward the air close to the ground.
+// Sprites are in the depth buffer but cast no volume here, as they cast no 3D shadow.
+uniform sampler2D attrTexture; // polygon ID * 4 + 1 for a sprite in r, the depth's high and low bytes in g and b, a set where opaque
+uniform ivec2 origin;          // the 3D viewport's corner in the framebuffer
+uniform int pixelStep;         // framebuffer pixels per DS pixel
+uniform ivec2 dsSize;
+uniform vec4 projection;       // the game's projection: m00, m11, m22, m32
+uniform float xScale;          // a wide scene libntr narrows
+uniform vec3 toSun;            // view space, unit length
+out vec4 color;
+
+// 0: nothing opaque there; otherwise the view distance (positive) of the surface. A sprite counts only when asked
+float Distance(ivec2 ds, bool withSprites)
+{
+    ivec4 a = ivec4(texelFetch(attrTexture, origin + ds * pixelStep + ivec2(pixelStep / 2), 0) * 255.0 + 0.5);
+    if (a.a == 0 || ((a.r & 1) == 1 && !withSprites)) {
+        return 0.0;
+    }
+    float ndcz = float(a.g * 256 + a.b) / 65535.0 * 2.0 - 1.0;
+    return projection.w / (ndcz + projection.z);
+}
+
+void main()
+{
+    ivec2 ds = ivec2(gl_FragCoord.xy);
+    float surface = Distance(ds, true);
+    float lit = 0.0;
+    if (surface > 0.0) {
+        vec2 ndc = ((vec2(ds) + 0.5) / vec2(dsSize)) * 2.0 - 1.0;
+        vec3 here = vec3(ndc.x / xScale * surface / projection.x, ndc.y * surface / projection.y, -surface);
+        // How far up the view ray, from the surface toward the eye, each sample sits (view units: 16 to a tile), and its weight
+        const float lift[4] = float[4](10.0, 26.0, 46.0, 72.0);
+        const float weight[4] = float[4](0.4, 0.3, 0.2, 0.1);
+        for (int k = 0; k < 4; k++) {
+            vec3 p = here * (1.0 - lift[k] / surface);
+            float open = 1.0;
+            for (int i = 1; i <= 9; i++) {
+                vec3 q = p + toSun * (7.0 * float(i));
+                float qDistance = -q.z;
+                if (qDistance <= 0.1) {
+                    break;
+                }
+                vec2 qNdc = vec2(q.x * projection.x * xScale / qDistance, q.y * projection.y / qDistance);
+                if (abs(qNdc.x) >= 1.0 || abs(qNdc.y) >= 1.0) {
+                    break; // off the screen: nothing known, the air stays lit
+                }
+                float scene = Distance(ivec2((qNdc * 0.5 + 0.5) * vec2(dsSize)), false);
+                float behind = qDistance - scene;
+                if (scene > 0.0 && behind > 3.0 && behind < 120.0) {
+                    open = 0.0;
+                    break;
+                }
+            }
+            lit += weight[k] * open;
+        }
+    }
+    color = vec4(lit, 0.0, 0.0, 1.0);
+}
+)""
