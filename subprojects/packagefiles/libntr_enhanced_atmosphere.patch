+  glProgramUniform1i(apply, WaterUniform(apply, "attrTexture"), kEdgeAttrTexUnit);
+  glProgramUniform2i(apply, WaterUniform(apply, "origin"), sG3Viewport[0], sG3Viewport[1]);
+  glProgramUniform2i(apply, WaterUniform(apply, "viewportSize"), sG3Viewport[2], sG3Viewport[3]);
