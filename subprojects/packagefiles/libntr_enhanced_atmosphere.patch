@@ -0,0 +1,39 @@
+R""(
+#version 420 core
+
+// Enhanced graphics' atmosphere, second pass, at full resolution: over what is drawn (not over what isn't), the sun's light
+// scattered by the air, from the march's texture (one texel a DS pixel, never filtered, so the light keeps the pixel grid),
+// and a haze that thickens toward the top of the screen (the far side of the field), in the colour of the sky at that hour.
+// The blend is premultiplied: the haze's colour with alpha as its share, over what is there; the shafts add to it.
+uniform sampler2D shaftTexture;
+uniform sampler2D attrTexture;
+uniform ivec2 origin;
+uniform ivec2 viewportSize;
+uniform int pixelStep;
+uniform int useShafts;
+uniform vec3 sunColor;      // the sun's light now
+uniform float shaftGain;
+uniform vec3 hazeColor;
+uniform float hazeAmount;   // the haze's share at the top of the screen
+uniform int debugMode;
+out vec4 color;
+
+void main()
+{
+    ivec2 fragment = ivec2(gl_FragCoord.xy);
+    if (texelFetch(attrTexture, fragment, 0).a < 0.5) {
+        discard;
+    }
+    float y = clamp(float(fragment.y - origin.y) / float(viewportSize.y), 0.0, 1.0);
+    float haze = hazeAmount * smoothstep(0.25, 1.0, y);
+    float shaft = 0.0;
+    if (useShafts == 1) {
+        shaft = texelFetch(shaftTexture, (fragment - origin) / pixelStep, 0).r;
+    }
+    if (debugMode == 1) {
+        color = vec4(vec3(shaft), 1.0);
+        return;
+    }
+    color = vec4(hazeColor * haze + sunColor * (shaft * shaftGain), haze);
+}
+)""
--- /dev/null
+++ b/libraries/sim/src/shaders/g3_bloom_bright_fragment.glsl
@@ -0,0 +1,23 @@
+R""(
+#version 420 core
+
+// Enhanced graphics' bloom, first pass, at the DS's own resolution: the bright, glowing parts of the finished frame (lamps,
+// lit windows, sparkles) and nothing else. The frame was copied down to one texel per DS pixel by picking a pixel, never
+// averaging, so the glow starts from the art's own colours. The colour is divided by the time of day's tint first: a lamp is
+// as bright at night as at noon, even though the grade darkens everything at night.
+uniform sampler2D sceneTexture;
+uniform vec3 tint;
+uniform float threshold; // luminance (of the colour before the grade) where the glow starts
+out vec4 color;
+
+void main()
+{
+    vec3 c = texelFetch(sceneTexture, ivec2(gl_FragCoord.xy), 0).rgb;
+    vec3 lit = min(c / max(tint, vec3(0.2)), vec3(1.0));
+    float luminance = dot(lit, vec3(0.299, 0.587, 0.114));
+    float peak = max(lit.r, max(lit.g, lit.b));
+    // Bright, and not merely light: a white wall in daylight is under the threshold, a lamp or a window isn't
+    float glow = smoothstep(threshold, min(threshold + 0.12, 1.0), min(luminance + 0.35 * (peak - luminance), 1.0));
+    color = vec4(lit * glow, 1.0);
+}
+)""
--- /dev/null
+++ b/libraries/sim/src/shaders/g3_bloom_blur_fragment.glsl
@@ -0,0 +1,22 @@
+R""(
+#version 420 core
+
+// Enhanced graphics' bloom, second and third pass: a gaussian blur at the DS's resolution, one direction at a time.
+uniform sampler2D source;
+uniform ivec2 direction; // (1, 0) or (0, 1)
+uniform ivec2 dsSize;
+out vec4 color;
+
+void main()
+{
+    const float weight[6] = float[6](0.2270, 0.1945, 0.1216, 0.0541, 0.0162, 0.0054);
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    vec3 sum = texelFetch(source, p, 0).rgb * weight[0];
+    for (int i = 1; i < 6; i++) {
+        ivec2 a = clamp(p + direction * i, ivec2(0), dsSize - 1);
+        ivec2 b = clamp(p - direction * i, ivec2(0), dsSize - 1);
+        sum += (texelFetch(source, a, 0).rgb + texelFetch(source, b, 0).rgb) * weight[i];
+    }
+    color = vec4(sum, 1.0);
+}
+)""
--- /dev/null
+++ b/libraries/sim/src/shaders/g3_bloom_apply_fragment.glsl
@@ -0,0 +1,17 @@
+R""(
+#version 420 core
+
+// Enhanced graphics' bloom, last pass, at full resolution: the blurred glow, smoothly enlarged (it is a haze of light, so
+// filtering it is right; the frame under it isn't touched), added over the frame.
+uniform sampler2D glowTexture; // filtered
+uniform ivec2 origin;
+uniform vec2 coverSize;        // the glow texture's size in framebuffer pixels
+uniform float strength;
+out vec4 color;
+
+void main()
+{
+    vec2 uv = (gl_FragCoord.xy - vec2(origin)) / coverSize;
+    color = vec4(texture(glowTexture, uv).rgb * strength, 1.0);
+}
+)""
