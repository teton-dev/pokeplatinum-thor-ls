+  glDrawArrays(GL_TRIANGLES, 0, 3);
+  glBindFramebuffer(GL_FRAMEBUFFER, g3BloomFbo[1]);
+  glBindTexture(GL_TEXTURE_2D, g3BloomTex[0]);
+  glProgramUniform2i(blur, WaterUniform(blur, "direction"), 0, 1);
+  glDrawArrays(GL_TRIANGLES, 0, 3);
