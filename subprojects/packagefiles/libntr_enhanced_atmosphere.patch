+      glBindFramebuffer(GL_FRAMEBUFFER, g3BloomFbo[i]);
+      glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, g3BloomTex[i], 0);
+    }
+    if (g3BloomSceneTex != 0) {
+      glDeleteTextures(1, &g3BloomSceneTex);
+    }
+    g3BloomSceneTex = WaterTexture(GL_RGBA8, dsWidth, dsHeight, GL_RGBA);
+    glBindFramebuffer(GL_FRAMEBUFFER, g3BloomSceneFbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, g3BloomSceneTex, 0);
