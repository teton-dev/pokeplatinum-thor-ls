+bool Slider(const char *label, const char *help, int *value, int min, int max, const char *format, bool enabled) {
+  if (sRec.active) {
+    const unsigned id = RecId(label, "slider");
+    bool changed = false;
+    if (RecEvent("step", id, label) && enabled) {
+      const int v = sRec.event.value < min ? min : (sRec.event.value > max ? max : sRec.event.value);
+      changed = v != *value;
+      *value = v;
+    }
+    char text[48];
+    snprintf(text, sizeof(text), format, *value);
+    RecBegin("slider", id);
+    RecStr("label", Shown(label));
+    RecStr("help", help);
+    RecInt("value", *value);
+    RecInt("min", min);
+    RecInt("max", max);
+    RecStr("text", text);
+    RecBool("en", enabled);
+    RecEnd();
+    return changed;
+  }
+  ImDrawList *draw = ImGui::GetWindowDrawList();
+  const float width = ImGui::GetContentRegionAvail().x;
+  const float pad = S(14.0f);
+  char text[48];
+  snprintf(text, sizeof(text), format, *value);
+  const ImVec2 valueSize = Measure(BoldFont(), S(17.0f), text);
+  const float textWidth = width - pad * 3 - valueSize.x;
+  const float textHeight = RowText(draw, ImVec2(0, 0), textWidth, label, help, enabled, true);
+  const float trackH = S(40.0f);
+  const float height = textHeight + pad * 2 + trackH;
+  ImVec2 pos = ImGui::GetCursorScreenPos();
+
+  draw->AddRectFilled(pos, ImVec2(pos.x + width, pos.y + height), kPanel, S(kRounding));
+  RowText(draw, ImVec2(pos.x + pad, pos.y + pad), textWidth, label, help, enabled, false);
+  Text(draw, BoldFont(), S(17.0f), ImVec2(pos.x + width - pad - valueSize.x, pos.y + pad), enabled ? kText : kTextOff,
+       text);
 
+  // The track: drag (or tap) anywhere along it; the arrows nudge it when it has the pad's cursor
+  const float knobR = S(11.0f);
+  const float x0 = pos.x + pad + knobR, x1 = pos.x + width - pad - knobR;
+  const float cy = pos.y + pad + textHeight + trackH * 0.5f;
+  ImVec2 areaPos(pos.x + pad, cy - trackH * 0.5f);
+  ImGui::SetCursorScreenPos(areaPos);
+  ImGui::PushID(label);
+  InvisibleItem("##slider", ImVec2(width - pad * 2, trackH), enabled);
+  ImGui::PopID();
+  bool changed = false;
+  if (enabled && ImGui::IsItemActive() && x1 > x0) {
+    float f = (ImGui::GetIO().MousePos.x - x0) / (x1 - x0);
+    f = f < 0.0f ? 0.0f : (f > 1.0f ? 1.0f : f);
+    const int v = min + (int)(f * (float)(max - min) + 0.5f);
+    if (v != *value) {
+      *value = v;
+      changed = true;
+    }
+  }
+  if (enabled && ImGui::IsItemFocused()) {
+    if (ImGui::IsKeyPressed(ImGuiKey_LeftArrow) && *value > min) {
+      (*value)--;
+      changed = true;
+    }
+    if (ImGui::IsKeyPressed(ImGuiKey_RightArrow) && *value < max) {
+      (*value)++;
+      changed = true;
+    }
+  }
+  const float f = max > min ? (float)(*value - min) / (float)(max - min) : 0.0f;
+  const float kx = x0 + (x1 - x0) * f;
+  const float trackThick = S(4.0f);
+  draw->AddRectFilled(ImVec2(x0, cy - trackThick * 0.5f), ImVec2(x1, cy + trackThick * 0.5f), kBackground, trackThick);
+  draw->AddRectFilled(ImVec2(x0, cy - trackThick * 0.5f), ImVec2(kx, cy + trackThick * 0.5f),
+                      enabled ? kAccent : kTextOff, trackThick);
+  draw->AddCircleFilled(ImVec2(kx, cy), knobR, enabled ? (ImGui::IsItemActive() ? kAccentPressed : kAccent) : kTextOff);
+  FocusRing(areaPos, ImVec2(areaPos.x + width - pad * 2, areaPos.y + trackH));
   EndRow(pos, width, height);
   return changed;
 }
