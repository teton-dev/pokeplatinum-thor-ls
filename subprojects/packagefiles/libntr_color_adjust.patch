+bool sColorBalance = false; // Display > Color Balance is open
+
+void DrawColorBalance() {
+  SIM_config_type *config = SIM_GetConfigPtr();
+  if (BackButton("Display")) {
+    sColorBalance = false;
+    RequestFocus();
+    return;
+  }
+  Section("Color Balance");
+  int saturation = config->colorSaturation, vibrance = config->colorVibrance, contrast = config->colorContrast,
+      whitePoint = config->colorWhitePoint;
+  bool changed = false;
+  changed |= Slider("Saturation", "How vivid the colors are. Lower looks greyer, higher more colorful.", &saturation,
+                    -25, 25, "%+d");
+  changed |= Slider("Vibrance", "Like saturation, but it lifts dull colors more than the ones that are already vivid.",
+                    &vibrance, -25, 25, "%+d");
+  changed |= Slider("Contrast", "The difference between dark and bright. Higher darkens the darks and brightens the "
+                    "lights.", &contrast, -25, 25, "%+d");
+  changed |= Slider("White point", "How bright white is. Lower tones down a washed out or too bright picture, "
+                    "higher brightens it.", &whitePoint, -25, 25, "%+d");
+  if (changed) {
+    config->colorSaturation = (s8)saturation;
+    config->colorVibrance = (s8)vibrance;
+    config->colorContrast = (s8)contrast;
+    config->colorWhitePoint = (s8)whitePoint;
+    SaveConfig();
+  }
+  const bool custom = saturation != 0 || vibrance != 0 || contrast != 0 || whitePoint != 0;
+  if (Button("Reset to default", "Back to the colors the game draws.", false, custom)) {
+    config->colorSaturation = config->colorVibrance = config->colorContrast = config->colorWhitePoint = 0;
+    SaveConfig();
   }
 }
 
