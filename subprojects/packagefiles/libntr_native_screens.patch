+
+bool sNativeScreenOn = false; // a carts screen is showing in the platform's views
+
+bool NativeScreen(void (*draw)()) {
+  if (!sNativeScreenOn && !sNative && !NativeWanted()) {
+    return false;
+  }
+  sNativeScreenOn = true;
 
+  std::string text;
+  {
+    std::lock_guard<std::mutex> lock(sNativeLock);
+    if (!sNativeEvents.empty()) {
+      text = sNativeEvents.front();
+      sNativeEvents.pop_front();
+    }
+  }
+  SIM::UI::NativeEvent event;
+  bool hasEvent = false, back = false;
+  if (!text.empty()) {
+    sNativeUrgent = 3;
+    if (text == "back" || text == "close") {
+      back = true; // the view's X closes the screen as back does
+    } else if (text != "list" && text != "classic" && text.compare(0, 5, "page ") != 0) {
+      hasEvent = ParseNativeEvent(text, &event);
+    }
+  }
+
+  ImGui::SetNextWindowPos(ImVec2(-20000.0f, -20000.0f));
+  ImGui::SetNextWindowSize(ImVec2(640.0f, 480.0f));
+  ImGui::Begin("##native screen", nullptr,
+               ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoNav |
+                   ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoFocusOnAppearing |
+                   ImGuiWindowFlags_NoBringToFrontOnFocus | ImGuiWindowFlags_NoBackground);
+  SIM::UI::BeginNativeRecording(hasEvent ? &event : nullptr, back);
+  draw();
+  bool eventUsed = false, backUsed = false, focusRequest = false;
+  unsigned focusId = 0;
+  const std::string items = SIM::UI::EndNativeRecording(&eventUsed, &backUsed, &focusId, &focusRequest);
+  ImGui::End();
+  if (!SIM_Carts_UIActive()) {
+    return true; // the screen finished itself: NativeScreenEnded follows
+  }
+  if (focusRequest) {
+    sNativeGen++;
+  }
+
+  std::string title;
+  bool backAllowed = false;
+  SIM::UI::NativeScreenInfo(&title, &backAllowed);
+  std::string escaped;
+  for (char c : title) {
+    escaped += c == '"' || c == '\\' ? std::string("\\") + c : std::string(1, c);
+  }
+  const std::string json = "{\"screen\":{\"title\":\"" + escaped + "\",\"back\":" + (backAllowed ? "true" : "false") +
+                           "},\"gen\":" + std::to_string(sNativeGen) + ",\"focus\":" + std::to_string(focusId) +
+                           ",\"items\":" + items + "}";
+  const Uint64 now = SDL_GetTicks64();
+  const bool urgent = sNativeUrgent > 0 || sNativeSent.empty();
+  if (sNativeUrgent > 0) {
+    sNativeUrgent--;
+  }
+  if (json != sNativeSent && (urgent || now - sNativeSentAt >= 250)) {
+    NativeSend(json);
+    sNativeSent = json;
+    sNativeSentAt = now;
+  }
+  return true;
+}
+
+void NativeScreenEnded() {
+  if (!sNativeScreenOn) {
+    return;
+  }
+  sNativeScreenOn = false;
+  sNativeSent.clear();
+  sNativeGen++;
+  sNativeUrgent = 3;
+  if (!sOpen || !sNative) {
+    NativeHide(); // it was alone: the view goes; with the settings open their page comes back through Draw()
+  }
+}
+
 void Close() {
   sOpen = false;
   sNativeSuspended = false;
