+#ifdef SDK_PORT
+// The channels that play, for SND_GetChannelStatus (the ARM7 driver's SND_UpdateSharedWork, which the simulator
+// doesn't have): NitroSystem's wave output (NNS_SndWaveOutIsPlaying) reads it. After the driver's work (in the audio
+// callback) and after each batch of commands (pxi.c)
+void SIM_SndUpdateChannelStatus(void)
+{
+    u32 status = 0;
+    int ch;
+
+    if (SNDi_SharedWork == NULL)
+        return;
+    for (ch = 0; ch < SND_CHANNEL_NUM; ch++)
+    {
+        if (SND_IsChannelActive7(ch))
+            status |= 1 << ch;
+    }
+    SNDi_SharedWork->channelStatus = status;
+}
+#endif
