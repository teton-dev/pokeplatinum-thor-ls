+// Clips a polygon (in clip space, before the divide by W) against the near and far planes,
+// -W <= Z <= W, as the DS's geometry engine does. Without it, polygons that reach behind the
+// camera (Black 2 and White 2's sky and ground) get negative or tiny W: they came out as huge
+// or flipped screen coordinates and were dropped. Returns the new vertex count (at most n + 2).
+static int G3SIM_ClipNearFar(G3SIM_FxVtx_t * in, int n, G3SIM_FxVtx_t * out)
+{
+    G3SIM_FxVtx_t tmp[8];
+    G3SIM_FxVtx_t * src = in;
+    int srcN = n;
+
+    for(int pass = 0; pass < 2; pass++) {
+        G3SIM_FxVtx_t * dst = (pass == 0) ? tmp : out;
+        int dstN = 0;
+        // pass 0: Z + W >= 0 (near), pass 1: W - Z >= 0 (far)
+        #define DIST(v) ((pass == 0) ? ((double)(v)->z + (double)(v)->w) : ((double)(v)->w - (double)(v)->z))
+        for(int i = 0; i < srcN; i++) {
+            G3SIM_FxVtx_t * cur = &src[i];
+            G3SIM_FxVtx_t * nxt = &src[(i + 1) % srcN];
+            double dc = DIST(cur), dn = DIST(nxt);
+            if(dc >= 0.0) {
+                dst[dstN++] = *cur;
+            }
+            if((dc >= 0.0) != (dn >= 0.0)) {
+                double t = dc / (dc - dn);
+                G3SIM_FxVtx_t * o = &dst[dstN++];
+                #define LERPI(f) o->f = (fx32)((double)cur->f + ((double)nxt->f - (double)cur->f) * t)
+                #define LERPF(f) o->f = (GLfloat)((double)cur->f + ((double)nxt->f - (double)cur->f) * t)
+                LERPI(x); LERPI(y); LERPI(z); LERPI(w);
+                LERPF(s); LERPF(t); LERPF(r); LERPF(g); LERPF(b); LERPF(a);
+                #undef LERPI
+                #undef LERPF
+            }
+        }
+        #undef DIST
+        if(dstN < 3) return 0;
+        src = dst;
+        srcN = dstN;
+    }
+    return srcN;
+}
