+static GLuint WaterTexture(GLint format, int width, int height, GLenum pixelFormat) {
+  GLuint id;
+  glGenTextures(1, &id);
+  glBindTexture(GL_TEXTURE_2D, id);
+  glTexImage2D(GL_TEXTURE_2D, 0, format, width, height, 0, pixelFormat, GL_UNSIGNED_BYTE, NULL);
+  // Never filtered: the art's pixels stay pixels
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  return id;
+}
+
+// (Re)makes a water target whose size changed: the mask the size of the 3D framebuffer, sharing its depth; the shore
+// distances one texel per DS pixel; the copy of the 3D viewport
+static void WaterResources(int fbWidth, int fbHeight, int dsWidth, int dsHeight, int vpWidth, int vpHeight) {
+  if (g3WaterMaskFbo == 0) {
+    glGenFramebuffers(1, &g3WaterMaskFbo);
+    glGenFramebuffers(1, &g3WaterOffsetFbo);
+    glGenFramebuffers(1, &g3WaterSceneFbo);
+  }
+  if (sWaterMaskW != fbWidth || sWaterMaskH != fbHeight) {
+    sWaterMaskW = fbWidth;
+    sWaterMaskH = fbHeight;
+    if (g3WaterMaskTex != 0) {
+      glDeleteTextures(1, &g3WaterMaskTex);
+    }
+    g3WaterMaskTex = WaterTexture(GL_R8, fbWidth, fbHeight, GL_RED);
+    glBindFramebuffer(GL_FRAMEBUFFER, g3WaterMaskFbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, g3WaterMaskTex, 0);
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_RENDERBUFFER, g3RenderBufferId);
+  }
+  if (sWaterOffsetW != dsWidth || sWaterOffsetH != dsHeight) {
+    sWaterOffsetW = dsWidth;
+    sWaterOffsetH = dsHeight;
+    if (g3WaterOffsetTex != 0) {
+      glDeleteTextures(1, &g3WaterOffsetTex);
+    }
+    g3WaterOffsetTex = WaterTexture(GL_R8, dsWidth, dsHeight, GL_RED);
+    glBindFramebuffer(GL_FRAMEBUFFER, g3WaterOffsetFbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, g3WaterOffsetTex, 0);
+  }
+  if (sWaterSceneW != vpWidth || sWaterSceneH != vpHeight) {
+    sWaterSceneW = vpWidth;
+    sWaterSceneH = vpHeight;
+    if (g3WaterSceneTex != 0) {
+      glDeleteTextures(1, &g3WaterSceneTex);
+    }
+    g3WaterSceneTex = WaterTexture(GL_RGBA8, vpWidth, vpHeight, GL_RGBA);
+    glBindFramebuffer(GL_FRAMEBUFFER, g3WaterSceneFbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, g3WaterSceneTex, 0);
+  }
+}
+
+// Enhanced graphics' water: the scene above the shore mirrored in the water tiles the game marked (SIM_SetPolygonTag).
+// Three cheap steps: the mask (a few quads against the scene's depth), each water pixel's distance to the shore at
+// the DS's resolution (a short march up the screen), and, at full resolution over the water's bounds only, the mirror
+// from a copy of the frame, in whole DS pixels so the art stays crisp at any resolution. Once per frame drawn; not
+// with anti-aliasing (the mask needs the depth buffer to be one sample per pixel).
+// Uniform locations never change once linked: found once, not by name every frame
+static GLint WaterUniform(GLuint program, const char *name) {
+  struct Cached { GLuint program; const char *name; GLint location; };
+  static Cached sCache[40];
+  static int sCount = 0;
+  for (int c = 0; c < sCount; c++) {
+    if (sCache[c].program == program && sCache[c].name == name) {
+      return sCache[c].location;
+    }
+  }
+  const GLint location = glGetUniformLocation(program, name);
+  if (sCount < 40) {
+    sCache[sCount++] = {program, name, location};
+  }
+  return location;
+}
