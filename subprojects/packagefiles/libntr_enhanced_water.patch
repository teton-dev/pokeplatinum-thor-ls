+    static const int sWaterDebug = (getenv("SIM_WATER_DEBUG") != nullptr && getenv("SIM_WATER_DEBUG")[0] != 0) ? atoi(getenv("SIM_WATER_DEBUG")) : 0;
+    glProgramUniform1i(g3WaterApplyProgramID, WaterUniform(g3WaterApplyProgramID, "debugMask"), sWaterDebug);
+    glEnable(GL_BLEND);
+    glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ZERO, GL_ONE);
+    glUseProgram(g3WaterApplyProgramID);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glDisable(GL_SCISSOR_TEST);
+    glDrawBuffers(2, kBoth);
+    glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+  }
+
+  glActiveTexture(GL_TEXTURE0);
+  glBindFramebuffer(GL_FRAMEBUFFER, g3FrameBuffer);
+  glBindVertexArray(vertexArray);
+  glUseProgram(g3shaderProgramID);
+  if (cullFace) {
+    glEnable(GL_CULL_FACE);
+  }
+  if (depthTest) {
+    glEnable(GL_DEPTH_TEST);
+  }
+  if (!blend) {
+    glDisable(GL_BLEND);
+  } else {
+    glEnable(GL_BLEND);
+  }
+  glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+}
