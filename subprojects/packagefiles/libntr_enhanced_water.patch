+R""(
+#version 420 core
+
+// Enhanced graphics' water, first pass, at the DS's own resolution (one fragment per DS pixel): for a water pixel, how
+// many DS pixels up the screen the shore is (the first pixel that isn't water), the mirror line of the reflection.
+// 0: not water, or no shore within reach. Stored times 4 (so up to 63 fits in a byte).
+uniform sampler2D maskTexture; // the mask, in framebuffer pixels
+uniform ivec2 origin;          // the 3D viewport's corner in the mask
+uniform int pixelStep;         // framebuffer pixels per DS pixel
+uniform ivec2 dsSize;          // the viewport in DS pixels
+uniform int maxDistance;
+out vec4 color;
+
+bool Water(ivec2 ds)
+{
+    return texelFetch(maskTexture, origin + ds * pixelStep + ivec2(pixelStep / 2), 0).r > 0.5;
+}
+
+void main()
+{
+    ivec2 ds = ivec2(gl_FragCoord.xy);
+    float result = 0.0;
+    if (Water(ds)) {
+        result = 1.0 / 255.0; // water with no shore in reach (distances are stored times 4, so 1 is below the least)
+        for (int i = 1; i <= maxDistance; i++) {
+            ivec2 up = ds + ivec2(0, i);
+            if (up.y >= dsSize.y) {
+                break;
+            }
+            if (!Water(up)) {
+                result = float(i * 4) / 255.0;
+                break;
+            }
+        }
+    }
+    color = vec4(result, 0.0, 0.0, 1.0);
+}
+)""
