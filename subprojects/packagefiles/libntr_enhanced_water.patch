+u32 G3SIM_DrawMask(float *bounds)
+{
+	const u32 count = s_G3MaskCount;
+	s_G3MaskCount = 0;
+	if(count == 0) {
+		return 0;
+	}
+	bounds[0] = bounds[1] = 1e9f;
+	bounds[2] = bounds[3] = -1e9f;
+	for(u32 i = 0; i < count; i++) {
+		bounds[0] = s_G3MaskVerts[i].x < bounds[0] ? s_G3MaskVerts[i].x : bounds[0];
+		bounds[1] = s_G3MaskVerts[i].y < bounds[1] ? s_G3MaskVerts[i].y : bounds[1];
