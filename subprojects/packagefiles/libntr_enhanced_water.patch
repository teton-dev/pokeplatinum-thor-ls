+R""(
+#version 420 core
+
+// Enhanced graphics' water, second pass, at full resolution over the water's bounds: the scene above the shore,
+// mirrored about it, mixed into the water. The mirror is a whole number of DS pixels away (with a small sideways ripple
+// that moves in whole DS pixels too) and read texel for texel, never filtered, so the art keeps its pixels at any
+// resolution.
+uniform sampler2D offsetTexture; // the first pass's result, one texel per DS pixel
+uniform sampler2D sceneTexture;  // a copy of the 3D viewport, from its corner
+uniform ivec2 origin;            // the 3D viewport's corner in the framebuffer
+uniform int pixelStep;
+uniform ivec2 dsSize;
+uniform float strength;          // 0 to 1: how much of the reflection shows at the shore
+uniform float time;              // seconds, for the ripple
+uniform vec3 waterTint;
+uniform int debugMask;           // SIM_WATER_DEBUG: the mask and the shore distances drawn as colour
+out vec4 color;
+
+void main()
+{
+    if (debugMask == 2) {
+        color = vec4(0.0, 1.0, 0.0, 0.5);
+        return;
+    }
+    ivec2 local = ivec2(gl_FragCoord.xy) - origin;
+    ivec2 ds = local / pixelStep;
+    int raw = int(texelFetch(offsetTexture, ds, 0).r * 255.0 + 0.5);
+    int distanceToShore = raw / 4;
+    if (debugMask == 1 && raw > 0) {
+        color = distanceToShore == 0 ? vec4(0.0, 0.0, 1.0, 0.5) : vec4(1.0, 0.0, 0.0, 0.5);
+        return;
+    }
+    if (distanceToShore == 0) {
+        discard;
+    }
+    // The ripple: whole DS pixels, a row at a time
+    int ripple = int(floor(sin(time * 2.4 + float(ds.y) * 0.85) * 1.5 + 0.5));
+    ivec2 sourceDs = ivec2(ds.x + ripple, ds.y + 2 * distanceToShore);
+    if (sourceDs.x < 0 || sourceDs.x >= dsSize.x || sourceDs.y >= dsSize.y) {
+        discard;
+    }
+    // What is mirrored must not be water itself
+    if (texelFetch(offsetTexture, sourceDs, 0).r > 0.0) {
+        discard;
+    }
+    ivec2 source = local + ivec2(ripple, 2 * distanceToShore) * pixelStep;
+    vec4 scene = texelFetch(sceneTexture, source, 0);
+    if (scene.a < 0.5) {
+        discard;
+    }
+    float fade = 1.0 - float(distanceToShore) / 40.0;
+    float k = strength * clamp(fade, 0.0, 1.0);
+    color = vec4(mix(scene.rgb, waterTint, 0.25), k);
+}
+)""
