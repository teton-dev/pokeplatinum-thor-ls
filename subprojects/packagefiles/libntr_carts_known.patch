+struct Xd1Reader {
+  const std::vector<u8> &b;
+  size_t pos = 0;
+  bool ok = true;
+  explicit Xd1Reader(const std::vector<u8> &bytes) : b(bytes) {}
+  const u8 *Raw(size_t n) {
+    if (!ok || pos + n > b.size()) {
+      ok = false;
+      return nullptr;
+    }
+    const u8 *p = &b[pos];
+    pos += n;
+    return p;
+  }
+  u32 Uint() { // 7 bits a byte, the high bit for "more"
+    u32 value = 0;
+    for (int shift = 0; shift < 35; shift += 7) {
+      const u8 *c = Raw(1);
+      if (c == nullptr) {
+        return 0;
+      }
+      value |= (u32)(*c & 0x7F) << shift;
+      if (!(*c & 0x80)) {
+        return value;
+      }
+    }
+    ok = false;
+    return 0;
+  }
+  bool Bool() {
+    const u8 *c = Raw(1);
+    return c != nullptr && *c != 0;
+  }
+};
