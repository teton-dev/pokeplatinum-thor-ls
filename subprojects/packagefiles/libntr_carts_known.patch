+  void Add(const u8 *data, size_t size) {
+    total += size;
+    while (size > 0) {
+      const size_t take = std::min(size, (size_t)64 - used);
+      memcpy(block + used, data, take);
+      used += take;
+      data += take;
+      size -= take;
+      if (used == 64) {
+        Block(block);
+        used = 0;
+      }
+    }
+  }
+
+  void Finish(u8 out[16]) {
+    const uint64_t bits = total * 8;
+    const u8 one = 0x80, zero = 0;
+    Add(&one, 1);
+    while (used != 56) {
+      Add(&zero, 1);
+    }
+    u8 length[8];
+    for (int i = 0; i < 8; i++) {
+      length[i] = (u8)(bits >> (8 * i));
+    }
+    Add(length, 8);
+    for (int i = 0; i < 4; i++) {
