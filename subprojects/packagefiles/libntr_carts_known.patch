+struct Xd1Source {
+  bool isData = false;
+  bool sequential = false;
+  u32 length = 0;
+  u8 md5[16] = {};
+};
+
+void ApplyXdelta1(const std::vector<u8> &source, const std::vector<u8> &patch, Applied &applied) {
+  const bool hasTrailer = true; // 1.0.4 and 1.1
+  const u32 flags = BigEndian32(&patch[8]);
+  const u32 names = BigEndian32(&patch[12]);
+  const size_t headerEnd = 32 + (names >> 16) + (names & 0xFFFF);
+  const size_t trailer = 4 + (hasTrailer ? 8 : 0);
+  if (headerEnd > patch.size() - trailer || memcmp(&patch[patch.size() - 8], patch.data(), 8) != 0) {
+    applied.error = "is a damaged xdelta 1 patch";
+    return;
+  }
+  const u32 controlOffset = BigEndian32(&patch[patch.size() - trailer]);
+  if (controlOffset < headerEnd || controlOffset > patch.size() - trailer) {
+    applied.error = "is a damaged xdelta 1 patch";
+    return;
+  }
+  const bool compressed = (flags & 8) != 0;
+  std::vector<u8> data, control;
+  if (!Gunzip(&patch[headerEnd], controlOffset - headerEnd, compressed, data) ||
+      !Gunzip(&patch[controlOffset], patch.size() - trailer - controlOffset, compressed, control)) {
+    applied.error = "is a damaged xdelta 1 patch (its compressed parts don't unpack)";
+    return;
+  }
+
+  Xd1Reader r(control);
+  r.Raw(8); // the object's type and size
+  const u8 *toMd5 = r.Raw(16);
+  u8 expected[16] = {};
+  if (toMd5 != nullptr) {
+    memcpy(expected, toMd5, 16);
+  }
+  const u32 toLength = r.Uint();
+  r.Bool(); // has_data
+  std::vector<Xd1Source> sources(std::min<u32>(r.Uint(), 4));
+  for (Xd1Source &info : sources) {
+    r.Raw(r.Uint()); // its name
+    const u8 *md5 = r.Raw(16);
+    if (md5 != nullptr) {
+      memcpy(info.md5, md5, 16);
+    }
+    info.length = r.Uint();
+    info.isData = r.Bool();
+    info.sequential = r.Bool();
+  }
+  const u32 count = r.Uint();
+  if (!r.ok || sources.empty() || toLength > 512u * 1024 * 1024) {
+    applied.error = "is a damaged xdelta 1 patch (its instructions can't be read)";
+    return;
+  }
+  std::vector<u32> position(sources.size(), 0);
+  applied.data.clear();
+  applied.data.reserve(toLength);
+  for (u32 i = 0; i < count && r.ok; i++) {
+    const u32 index = r.Uint();
+    u32 offset = r.Uint();
+    const u32 length = r.Uint();
+    if (index >= sources.size()) {
+      r.ok = false;
+      break;
+    }
+    if (sources[index].sequential) {
+      offset = position[index];
+      position[index] = offset + length;
+    }
+    const std::vector<u8> &from = sources[index].isData ? data : source;
+    if ((size_t)offset + length > from.size() || applied.data.size() + length > toLength) {
+      // Copies past the source's end: a source this patch wasn't made for
+      applied.mismatches = 1;
+      applied.data.clear();
+      return;
+    }
+    applied.data.insert(applied.data.end(), from.begin() + offset, from.begin() + offset + length);
+  }
+  if (!r.ok) {
+    applied.error = "is a damaged xdelta 1 patch (its instructions can't be read)";
+    applied.data.clear();
+    return;
+  }
+  // The output's MD5 is the patch's own check (the source's isn't: a ROM that differs only where the patch
+  // doesn't copy from still gives the right game)
+  u8 got[16];
+  Md5Of(applied.data.data(), applied.data.size(), got);
+  if (applied.data.size() != toLength || memcmp(got, expected, 16) != 0) {
+    applied.mismatches = 1;
+  }
+}
