+// --- xdelta 1.1 patches (xdelta1's xdmain.c, xdelta.c and xd.ser) -----------------------------
+// "%XDZ004%" (1.1) or "%XDZ003%" (1.0.4), six big-endian words (flags; the two names' lengths), the names, then a
+// gzip'd data segment, a gzip'd control (libedsio-serialized XdeltaControl) at the offset in the last 12 bytes
+// (offset, magic again). The output is a run of copies, each from the data segment or the source file; its MD5 is
+// the control's to_md5.
+
+bool IsXdelta1(const std::vector<u8> &patch) {
+  return patch.size() >= 44 && (memcmp(patch.data(), "%XDZ004%", 8) == 0 || memcmp(patch.data(), "%XDZ003%", 8) == 0);
+}
+
+u32 BigEndian32(const u8 *p) {
+  return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3];
+}
+
+// A gzip member's contents (RFC 1952), or the bytes as they are when they aren't gzip'd
+bool Gunzip(const u8 *data, size_t size, bool compressed, std::vector<u8> &out) {
+  if (!compressed || size < 18 || data[0] != 0x1F || data[1] != 0x8B) {
+    out.assign(data, data + size);
+    return true;
+  }
+  if (data[2] != 8) {
+    return false;
+  }
+  const u8 flags = data[3];
+  size_t pos = 10;
+  if (flags & 4) { // FEXTRA
+    pos += 2 + (data[pos] | (data[pos + 1] << 8));
+  }
+  if (flags & 8) { // FNAME
+    while (pos < size && data[pos] != 0) {
+      pos++;
+    }
+    pos++;
+  }
+  if (flags & 16) { // FCOMMENT
+    while (pos < size && data[pos] != 0) {
+      pos++;
+    }
+    pos++;
+  }
+  if (flags & 2) { // FHCRC
+    pos += 2;
+  }
+  if (pos + 8 > size) {
+    return false;
+  }
+  int length = 0;
+  char *inflated = stbi_zlib_decode_noheader_malloc((const char *)data + pos, (int)(size - pos - 8), &length);
+  if (inflated == nullptr) {
+    return false;
+  }
+  out.assign((u8 *)inflated, (u8 *)inflated + length);
+  free(inflated);
+  return true;
+}
