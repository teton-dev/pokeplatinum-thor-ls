 static GLuint s_G3DrawVertexBuffer;
 
 extern G3SIM_TexImageParam_t s_texImageParam;
+
+// The bound texture's wrapping, from TEXIMAGE_PARAM: repeat, mirrored repeat or, with repeat off,
+// clamped to the edge texel as the DS does. The translucent polygons drawn at the end of the frame
+// set theirs too (they always repeated, and HGSS's starter balls showed their clamped spotlight
+// tiled across each ball)
+static void G3SIM_ApplyTexWrap(const G3SIM_TexImageParam_t *param)
+{
+	GLint s = param->repeatS ? (param->flipS ? GL_MIRRORED_REPEAT : GL_REPEAT) : GL_CLAMP_TO_EDGE;
+	GLint t = param->repeatT ? (param->flipT ? GL_MIRRORED_REPEAT : GL_REPEAT) : GL_CLAMP_TO_EDGE;
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, s);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, t);
+}
 extern G3SIM_PolygonAttr_t s_curPolygonAttr;
