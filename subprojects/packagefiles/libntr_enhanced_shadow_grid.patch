+float Texture::FeetFraction(float s0, float ds, float tb, float dt) const {
+  if (mWidth == 0 || mHeight == 0 || mAlpha.empty()) {
+    return 0.0f;
+  }
+  const float spanS = ds < 0 ? -ds : ds, spanT = dt < 0 ? -dt : dt;
+  const int rows = (int)(spanT * mHeight + 0.5f), columns = (int)(spanS * mWidth + 0.5f);
+  if (rows < 1 || columns < 1) {
+    return 0.0f;
+  }
+  for (int r = 0; r < rows; r++) {
+    const float t = tb + dt * ((float)r + 0.5f) / (float)rows;
+    int y = (int)(t * mHeight);
+    y = y < 0 ? 0 : (y >= mHeight ? mHeight - 1 : y);
+    for (int c = 0; c < columns; c++) {
+      const float s = s0 + ds * ((float)c + 0.5f) / (float)columns;
+      int x = (int)(s * mWidth);
+      x = x < 0 ? 0 : (x >= mWidth ? mWidth - 1 : x);
+      if (mAlpha[(size_t)y * mWidth + x] >= 128) {
+        return (float)r / (float)rows;
+      }
+    }
+  }
+  return 0.0f;
+}
+
 Texture::~Texture() {
     glDeleteTextures(1, &mGlTextureId);
 }
