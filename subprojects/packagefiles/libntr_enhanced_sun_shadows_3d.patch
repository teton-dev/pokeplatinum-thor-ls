+R""(
+#version 420 core
+
+// Enhanced graphics' sun shadows of the 3D, between the march and the multiply, at the DS's resolution: the march's mask has
+// small holes (a ray that slips between two steps of a thin edge) and stray specks and dashes (a ray that grazes a surface).
+// A pixel stays in shadow when at least four of the nine around it (itself included) are, and a pixel not in shadow joins
+// it when at least six are: holes close and specks go, the shape of a shadow stays
+uniform sampler2D maskTexture;
+uniform ivec2 dsSize;
+out vec4 color;
+
+void main()
+{
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    int count = 0;
+    for (int y = -1; y <= 1; y++) {
+        for (int x = -1; x <= 1; x++) {
+            ivec2 q = clamp(p + ivec2(x, y), ivec2(0), dsSize - 1);
+            count += texelFetch(maskTexture, q, 0).r > 0.5 ? 1 : 0;
+        }
+    }
