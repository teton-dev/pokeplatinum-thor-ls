+R""(
+#version 420 core
+
+// Enhanced graphics' sun shadows of the scene's 3D, second pass: at full resolution, the pixels the first pass found in shadow
+// are multiplied by the shadow's tone (the blend multiplies, so nothing is read from the frame). One texel of the mask is a
+// DS pixel, never filtered, so the shadow's edges are DS pixels.
+uniform sampler2D maskTexture;
+uniform ivec2 origin;
+uniform int pixelStep;
+uniform vec3 tone;  // the multiplier at the shadow's full strength
+uniform int debugMask; // SIM_SUNSHADOW_DEBUG: 1 paints the mask, 2 the distances as grey bands
+out vec4 color;
+
+void main()
+{
+    vec4 mask = texelFetch(maskTexture, (ivec2(gl_FragCoord.xy) - origin) / pixelStep, 0);
+    if (debugMask == 2) {
+        color = vec4(vec3(mask.g), 1.0);
+        return;
+    }
+    if (mask.r < 0.5) {
+        if (debugMask == 1) {
+            color = vec4(1.0);
+            return;
+        }
+        discard;
+    }
+    color = debugMask == 1 ? vec4(1.0, 0.0, 0.0, 1.0) : vec4(tone, 1.0);
+}
+)""
