+R""(
+#version 420 core
+
+// Enhanced graphics' sun shadows of the scene's 3D (trees, signs, houses, cliffs), first pass, at the DS's own resolution
+// (one fragment per DS pixel, so the shadow keeps the pixel grid): from the pixel's place in the scene, rebuilt from the
+// depth the 3D shader left in the attribute texture, a short march toward the sun in view space; a pixel the ray meets
+// something nearer than itself on its way is in shadow. The sprites are in the depth buffer too but don't cast here
+// (they have shadows of their own, from their pictures) and don't receive.
+uniform sampler2D attrTexture; // polygon ID * 4 + 1 for a sprite in r, the depth's high and low bytes in g and b, a set where opaque
+uniform ivec2 origin;          // the 3D viewport's corner in the framebuffer
+uniform ivec2 viewportSize;    // in framebuffer pixels
+uniform int pixelStep;         // framebuffer pixels per DS pixel
+uniform ivec2 dsSize;
+uniform vec4 projection;       // the game's projection: m00, m11, m22, m32
+uniform float xScale;          // a wide scene libntr narrows
+uniform vec3 toSun;            // view space, unit length
+uniform vec3 march;            // distance to the first step, step length, thickness it still counts as in the way (view units)
+uniform int steps;
+out vec4 color;
+
+// 0: nothing opaque there (or a sprite); otherwise the view distance (positive) of the surface
+float Distance(ivec2 ds)
+{
+    ivec4 a = ivec4(texelFetch(attrTexture, origin + ds * pixelStep + ivec2(pixelStep / 2), 0) * 255.0 + 0.5);
+    if (a.a == 0 || (a.r & 1) == 1) {
+        return 0.0;
+    }
+    float ndcz = float(a.g * 256 + a.b) / 65535.0 * 2.0 - 1.0;
+    return projection.w / (ndcz + projection.z); // = -view z: z_view = -m32 / (ndcz + m22), and m32 and m22 are negative
+}
+
+// How wide the surface at ds is, in view units, along the ray's direction on the screen: the run of pixels around it that
+// are one continuous surface (neighbours within a couple of units of each other), up to 24 each way. A post is a few
+// pixels, a house dozens; a ray that passes behind a thing is only blocked by it if it is not much thinner than the
+// distance the ray is behind it (a post doesn't shade what is far behind it, a house does)
+float Extent(ivec2 ds, float distHere, ivec2 dir)
+{
+    int run = 1;
+    for (int side = 0; side < 2; side++) {
+        ivec2 at = ds;
+        float last = distHere;
+        for (int i = 0; i < 24; i++) {
+            at += side == 0 ? dir : -dir;
+            float d = Distance(at);
+            if (d <= 0.0 || abs(d - last) > 2.5) {
+                break;
+            }
+            last = d;
+            run++;
+        }
+    }
+    float pixelWorld = distHere * 2.0 / (projection.x * float(dsSize.x)) / xScale;
+    return float(run) * pixelWorld;
+}
+
+void main()
+{
+    ivec2 ds = ivec2(gl_FragCoord.xy);
+    float distanceHere = Distance(ds);
+    float shadow = 0.0;
+    if (distanceHere > 0.0) {
+        vec2 ndc = ((vec2(ds) + 0.5) / vec2(dsSize)) * 2.0 - 1.0;
+        // the view-space position: x = ndc.x * distance / m00 (the narrowed scene's x is stretched back first)
+        vec3 here = vec3(ndc.x / xScale * distanceHere / projection.x, ndc.y * distanceHere / projection.y, -distanceHere);
+        // The ray's direction on the screen, in whole pixels, for measuring what it passes behind
+        vec2 screenDirection = vec2(toSun.x * projection.x * xScale, toSun.y * projection.y);
+        screenDirection /= max(max(abs(screenDirection.x), abs(screenDirection.y)), 1e-4);
+        ivec2 rayStep = ivec2(round(screenDirection));
+        for (int i = 0; i < steps; i++) {
+            vec3 q = here + toSun * (march.x + march.y * float(i));
+            float qDistance = -q.z;
+            if (qDistance <= 0.1) {
+                break;
+            }
+            vec2 qNdc = vec2(q.x * projection.x * xScale / qDistance, q.y * projection.y / qDistance);
+            if (abs(qNdc.x) >= 1.0 || abs(qNdc.y) >= 1.0) {
+                break; // off the screen: nothing known
+            }
+            ivec2 qDs = ivec2((qNdc * 0.5 + 0.5) * vec2(dsSize));
+            float scene = Distance(qDs);
+            // something nearer than the ray's point, but not an arbitrarily thick wall of it
+            float behind = qDistance - scene;
+            if (scene > 0.0 && behind > 1.0 + 0.01 * qDistance && behind < march.z) {
+                // Close behind the surface: blocked. Farther behind: only if the thing is that wide (about as wide as
+                // the gap), so thin posts make thin shadows and walls and roofs keep theirs
+                if (behind < 4.0 || behind < 4.0 + Extent(qDs, scene, ivec2(1, 0))) {
+                    shadow = 1.0;
+                    break;
+                }
+            }
+        }
+    }
+    // b: 1 where nothing is shaded (a sprite, or nothing drawn): the clean-up pass leaves those alone
+    color = vec4(shadow, fract(distanceHere / 16.0), distanceHere > 0.0 ? 0.0 : 1.0, 1.0);
+}
+)""
