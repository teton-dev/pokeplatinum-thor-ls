+// The port's C for the DS build's hand-written assembly (Gen 5 battles): the same reads of the NARC's header, FATB and
+// FNTB, and the same assert, with its strings from sAssertNameAndFormat.
+static u32 ArchiveMoveImageTop(FSFile *file, u32 fileId, u32 offset, u32 size) {
+    u32 fatbTop = 0;
+    u32 fntbTop, imgTop, chunkSize;
+    u16 fileCount;
+    u32 range[2];
 
-// clang-format on
+    FS_SeekFile(file, 0xC, FS_SEEK_SET);
+    FS_ReadFile(file, &fatbTop, 2);
+    FS_SeekFile(file, fatbTop + 4, FS_SEEK_SET);
+    FS_ReadFile(file, &chunkSize, 4);
+    FS_ReadFile(file, &fileCount, 2);
+    if (fileCount <= fileId) {
+        GFL_DebugAssertFailEx(sAssertNameAndFormat, 0, sAssertNameAndFormat + 4, fileCount, fileId);
+    }
 
+    fntbTop = fatbTop + chunkSize;
+    FS_SeekFile(file, fntbTop + 4, FS_SEEK_SET);
+    FS_ReadFile(file, &chunkSize, 4);
+    imgTop = fntbTop + chunkSize + 8;
+
+    FS_SeekFile(file, fatbTop + 0xC + fileId * 8, FS_SEEK_SET);
+    FS_ReadFile(file, range, 8);
+    FS_SeekFile(file, imgTop + range[0] + offset, FS_SEEK_SET);
+    if (size == 0) {
+        size = range[1] - range[0];
+    }
+    return size;
+}
