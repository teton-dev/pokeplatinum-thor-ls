 BOOL BtlvCore_StartMsgTrainer(BtlvCore *core, u32 trainerId, u32 msgId) {
+    // The port: trainers from 0x800 (another game's, as the Pokémon World Tournament's) have their defeat line in
+    // the port's trainer (each of two trainers its own), not in BW2's trainer messages
+    if (trainerId >= 0x800 && msgId == 1) {
+        if (!Gen5_PortTrainerDefeatText(core->strbuf, trainerId) || GFL_StrBufGetCharCount(core->strbuf) == 0) {
+            return FALSE;
+        }
+        BtlvCore_StartMsgStr(core, core->strbuf, 0x50, NULL);
+        return TRUE;
+    }
     if (TrainerMsg_CheckExists(trainerId, msgId, core->heapId)) {
         TrainerMsg_Load(trainerId, msgId, core->strbuf, core->heapId);
         BtlvCore_StartMsgStr(core, core->strbuf, 0x50, NULL);
@@ -1451,6 +1783,26 @@
     return BtlvScu_WaitAbilityWinChange(core->scu, pos);
 }
 
