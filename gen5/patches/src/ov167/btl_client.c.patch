+void BtlvCore_PortShowWeatherWin(BtlvCore *core, BOOL player, u8 weather, u8 turns);
+BOOL BtlvCore_PortWaitShowWeatherWin(BtlvCore *core, BOOL player);
+BOOL BtlvCore_PortHideWeatherWin(BtlvCore *core, BOOL player);
