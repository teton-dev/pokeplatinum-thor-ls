+static BOOL BattleClient_ScWeatherTurn(BtlClient *client, s32 *seq, const u32 *args) {
+    static u16 sWait;
+    BOOL player = FALSE;
+
+    if (args[0] != 0xff) {
+        player = IsPlayerSide(client->mainModule, GetClientSide(client->mainModule, GetClientIDFromMonID(args[0])));
+    }
+    switch (*seq) {
+    case 0:
+        if (BattleClient_IsChapterSkipping(client)) {
             return TRUE;
         }
+        BtlvCore_PortShowWeatherWin(client->viewCore, player, args[1], args[2]);
+        (*seq)++;
         break;
+    case 1:
+        if (BtlvCore_PortWaitShowWeatherWin(client->viewCore, player)) {
+            sWait = 40;
+            (*seq)++;
+        }
+        break;
+    case 2:
+        if (sWait != 0) {
+            sWait--;
+        } else {
+            (*seq)++;
+        }
+        break;
+    case 3:
+        // The bar goes, and its palette comes back
+        if (BtlvCore_PortHideWeatherWin(client->viewCore, player)) {
+            return TRUE;
+        }
+        break;
     }
     return FALSE;
 }
