+
+// chart: the 18 x 18 table (attacking type by defending type, in halves: 0, 2, 4 or 8), or NULL for BW2's own,
+// where Fairy has no effect on anything and nothing on it
+void Gen5_PortTypeChart(const u8 *chart) {
+    int a, d;
+
+    for (a = 0; a < 18; a++) {
+        for (d = 0; d < 18; d++) {
+            if (chart != NULL) {
+                TYPE_CHART[a][d] = chart[a * 18 + d];
+            } else {
+                TYPE_CHART[a][d] = (a < 17 && d < 17) ? TYPE_CHART_BW2[a][d] : 4;
+            }
+        }
+    }
+    sTypeChartReady = TRUE;
+}
+
+static void TypeChartInit(void) {
+    if (!sTypeChartReady) {
+        Gen5_PortTypeChart(NULL);
+    }
