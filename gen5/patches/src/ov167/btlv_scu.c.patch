+// The port: the weather's bar. The bar of an ability with the weather's name and turns left, in the weather's colors:
+// two the palette's colors from dark to light (Gen5_PortWeatherText: runtime.c)
+void Gen5_PortWeatherText(StrBuf *strbuf, u8 weather, u8 turns);
+void Gen5_PortSafariBarText(StrBuf *strbuf, int balls); // The Safari Zone's bar (weather 5, turns the balls left)
+
+// The colors of each weather's bar, dark then light, as red, green and blue 0 to 31
+static const u8 sPortWeatherColors[6][2][3] = {
+    { { 0, 0, 0 }, { 0, 0, 0 } },        // none
+    { { 24, 8, 0 }, { 31, 26, 6 } },     // sun: orange to yellow
+    { { 2, 6, 20 }, { 14, 24, 31 } },    // rain: dark to light blue
+    { { 21, 23, 27 }, { 31, 31, 31 } },  // hail: light gray to white
+    { { 13, 7, 1 }, { 28, 22, 6 } },     // sandstorm: brown to yellow
+    { { 3, 12, 5 }, { 17, 29, 13 } },    // the Safari Zone's balls: dark to light green
+};
+
+// The bar's own palette (the file's, before a tint), by side
+static u16 sPortBarPalette[2][16];
+static BOOL sPortBarPaletteSaved[2];
+
+// Colors the bar's palette for a weather, or gives it back for 0. The text's colors (1 and 2) stay
+static void BtlvScuAbilityWin_PortTint(BtlvScuAbilityWin *win, u8 weather) {
+    PaletteFade *fade = BtlvEffect_GetPaletteFade();
+    u16 *unfaded = PaletteFade_GetUnfadedBuffer(fade, 0) + 16 * (win->side + 1);
+    u16 *faded = PaletteFade_GetFadedBuffer(fade, 0) + 16 * (win->side + 1);
+    u32 i;
+
+    if (!sPortBarPaletteSaved[win->side]) {
+        for (i = 0; i < 16; i++) {
+            sPortBarPalette[win->side][i] = unfaded[i];
         }
+        sPortBarPaletteSaved[win->side] = TRUE;
     }
+    for (i = 0; i < 16; i++) {
+        u16 color = sPortBarPalette[win->side][i];
+
+        if (weather != 0 && weather < 6 && i > 2) {
+            u32 r = color & 31;
+            u32 g = (color >> 5) & 31;
+            u32 b = (color >> 10) & 31;
+            u32 light = (r * 2 + g * 5 + b) / 8; // 0 to 31
+            const u8 (*c)[3] = sPortWeatherColors[weather];
+
+            r = c[0][0] + (c[1][0] - c[0][0]) * light / 31;
+            g = c[0][1] + (c[1][1] - c[0][1]) * light / 31;
+            b = c[0][2] + (c[1][2] - c[0][2]) * light / 31;
+            color = r | (g << 5) | (b << 10);
+        }
+        unfaded[i] = color;
+        faded[i] = color;
+    }
 }
 
+void BtlvScu_PortShowWeatherWin(BtlvScu *scu, BOOL player, u8 weather, u8 turns) {
+    BtlvScuAbilityWin *win = &scu->abilityWins[player ? BTLV_SCU_SIDE_PLAYER : BTLV_SCU_SIDE_ENEMY];
+
+    if (win->shown) {
+        BtlvScuAbilityWin_Hide(win);
+    }
+    if (player) {
+        BtlvEffect_SetTimerVisible(BTLV_TIMER_BATTLE, 0, 0);
+    }
+    BtlvEffect_ClearVoices();
+    BtlvScuAbilityWin_PortTint(win, weather);
+    win->portWeather = weather;
+    win->portTurns = turns;
+    win->ability = 0xFFFF;
+    win->monId = 0x1F;
+    BtlvScuAbilityWin_DrawText(win);
+    win->flash = TRUE;
+    win->seq = 0;
+}
+
+BOOL BtlvScu_PortWaitShowWeatherWin(BtlvScu *scu, BOOL player) {
+    return BtlvScuAbilityWin_RunShow(&scu->abilityWins[player ? BTLV_SCU_SIDE_PLAYER : BTLV_SCU_SIDE_ENEMY]);
+}
+
+// Hides the bar and gives its palette back (a fade of it off the screen puts it in VRAM); TRUE when that is done
+BOOL BtlvScu_PortHideWeatherWin(BtlvScu *scu, BOOL player) {
+    BtlvScuAbilityWin *win = &scu->abilityWins[player ? BTLV_SCU_SIDE_PLAYER : BTLV_SCU_SIDE_ENEMY];
+
+    if (win->portWeather != 0) {
+        win->portWeather = 0;
+        win->ability = 0xFFFF;
+        win->monId = 0x1F;
+        BtlvScuAbilityWin_Hide(win);
+        if (player) {
+            BtlvEffect_SetTimerVisible(BTLV_TIMER_BATTLE, 1, 0);
+        }
+        BtlvScuAbilityWin_PortTint(win, 0);
+        PaletteFade_StartFade(BtlvEffect_GetPaletteFade(), 1, 1 << (win->side + 1), 0, 16, 0, 0x7FFF,
+                              BtlvEffect_GetTCBManager());
+        return FALSE;
+    }
+    return PaletteFade_GetActiveMask(BtlvEffect_GetPaletteFade()) == 0;
+}
