+// The port: moves whose slot a hack uses for another move have no handlers of their own (Gen5_PortNoHandlers)
+static u16 sNoHandlerMoves[16];
+static u32 sNumNoHandlerMoves;
+void Gen5_PortNoHandlers(const u16 *moves, u32 count) {
+    for (sNumNoHandlerMoves = 0; sNumNoHandlerMoves < count && sNumNoHandlerMoves < 16; sNumNoHandlerMoves++) {
+        sNoHandlerMoves[sNumNoHandlerMoves] = moves[sNumNoHandlerMoves];
+    }
+}
