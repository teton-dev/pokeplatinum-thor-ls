+// The port: in HeartGold and SoulSilver (Gen5_PortApricornBalls) an Apricorn Ball reads a Poke Ball's data, which BW2's
+// own lacks (no battle pocket: the battle's bag wouldn't list it). Its number, name, icon and catch rate stay its own
+static u16 Gen5_PortItemDataOf(u16 item) {
+    if (Gen5_PortApricornBalls() && item >= ITEM_FAST_BALL && item <= ITEM_SPORT_BALL) {
+        return ITEM_POKE_BALL;
+    }
+    return item;
+}
