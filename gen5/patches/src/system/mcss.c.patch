+// The port (teton-dev fork): the player's own back sprite (gen5/player_back.h)
+
+void MCSSSys_SetNextBackSprite(MCSSSystem *system, const Gen5BackSprite *sprite) {
+    system->nextBackSprite = sprite;
+}
+
+// The art's image and colors in place of the sprite's, once its files are read. A sprite whose image isn't the size
+// of the art's, 256x128 at 4 bits a pixel, keeps its own
+static void MCSS_LoadBackSprite(MCSS *mcss, MCSSLoad *load) {
+    const Gen5BackSprite *sprite = mcss->backSprite;
+
+    if (sprite == NULL) {
+        return;
+    }
+    if (load->chars->pixelFmt != GX_TEXFMT_PLTT16 || load->chars->W != 32 || load->chars->H != 16
+        || load->chars->szByte < GEN5_BACK_TEXTURE_SIZE || load->pltt->szByte < 16 * sizeof(u16)) {
+        mcss->backSprite = NULL;
+        return;
+    }
+    MI_CpuCopy8(sprite->texture, load->chars->pRawData, GEN5_BACK_TEXTURE_SIZE);
+    MI_CpuCopy16(sprite->palette, load->pltt->pRawData, 16 * sizeof(u16));
+    MI_CpuCopy16(sprite->palette, mcss->pltt, 16 * sizeof(u16));
+}
+
+// The art's pose for the multi-cell that the animation shows, moved, turned and scaled as the multi-cell is. Its quads
+// are drawn as cells are, with their shadows
+static void MCSS_DrawBackSprite(MCSSSystem *system, MCSS *mcss, const NNSG2dAnimDataSRT *mcSrt, BOOL ortho, fx32 *z,
+                                u8 flip) {
+    const Gen5BackSprite *sprite = mcss->backSprite;
+    int poseIndex = mcSrt->index < sprite->poseCount ? mcSrt->index : 0;
+    const Gen5BackPose *pose;
+    NNSG2dAnimDataSRT cellSrt;
+    int j;
+
+    if (sprite->useFixed) {
+        // A trainer's art that stands in one pose
+        poseIndex = sprite->lastPose;
+    } else if (sprite->seqCount > 0) {
+        // A trainer's art that plays Platinum's animation once, by time, then stands in its last pose
+        u32 elapsed = Gen5_ArtTicks() - mcss->artStart;
+        u32 end = 0;
+        int step;
+
+        poseIndex = sprite->lastPose;
+        for (step = 0; step < sprite->seqCount; step++) {
+            end += sprite->seqTicks[step];
+            if (elapsed < end) {
+                poseIndex = sprite->seqPose[step];
+                break;
+            }
+        }
+    }
+    pose = &sprite->poses[poseIndex < sprite->poseCount ? poseIndex : 0];
+    cellSrt.index = 0;
+    cellSrt.rotZ = 0;
+    cellSrt.sx = FX32_ONE;
+    cellSrt.sy = FX32_ONE;
+    cellSrt.px = 0;
+    cellSrt.py = 0;
+    for (j = 0; j < pose->count; j++) {
+        int k = (mcss->alpha != MCSS_ALPHA_MAX || mcss->reverse) ? pose->count - 1 - j : j;
+        const Gen5BackQuad *quad = &sprite->quads[pose->first + k];
+
+        // A cell's position is in 1/16 of a pixel's fx32, its size and texture coordinates in pixels
+        MCSS_DrawQuad(system, mcss, quad->x * (FX32_ONE / 16), quad->y * (FX32_ONE / 16), quad->width * FX32_ONE,
+                      quad->height * FX32_ONE, quad->s * FX32_ONE, quad->t * FX32_ONE, &cellSrt, mcSrt,
+                      &system->shadowPltt, k, ortho, z, flip);
+    }
+}
